# Dockerfile.cli — AI-Phone-Debloater CLI
# Enterprise build: deterministic, pinned base image, non-root user.
FROM python:3.11-slim AS builder

WORKDIR /app

# Python environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# System dependencies needed to run ADB and launch the engine
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip bash \
    && rm -rf /var/lib/apt/lists/*

# Copy only the CLI package
COPY cli /app/cli

WORKDIR /app/cli

# Verify engine compiles cleanly
RUN python -m py_compile src/debloat_engine.py tests/validate_rules.py tests/test_connection.py

# Verify rule databases load and collide-free
RUN python tests/validate_rules.py

# Non-root user for safe execution
RUN useradd --create-home --shell /bin/bash debloater
USER debloater

WORKDIR /app/cli
ENV PATH="/root/.local/bin:$PATH"

ENTRYPOINT ["python", "src/debloat_engine.py"]
CMD ["--interactive"]

FROM builder AS runtime
WORKDIR /app/cli
USER debloater
ENTRYPOINT ["python", "src/debloat_engine.py"]
CMD ["--interactive"]
