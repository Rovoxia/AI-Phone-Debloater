---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

const SITE_URL = 'https://debloater.rovoxia.com';
const CANONICAL_URL = `${SITE_URL}/`;
const TITLE = 'AI Phone Debloater — The Safe, Open-Source Android Debloater';
const DESCRIPTION = 'Clean Android bloatware safely without root. Automated AI prompts, powerful CLI tools, and visual WebApp powered by 320+ curated OEM rules. 100% reversible, automated backups, instant rollbacks.';
const KEYWORDS = 'AI Phone Debloater, Android debloater, bloatware remover, ADB debloat, Samsung debloat, Xiaomi debloat, rootless debloater';

const totalRules = 330;

// Curated representative rules across safety tiers
const sampleRules = [
  {
    tier: 'Tier 1 • Safe',
    tierColor: 'emerald',
    pkg: 'com.miui.msa.global',
    name: 'Xiaomi Ad Daemon',
    type: 'Adware & Telemetry',
    action: 'Safe to Disable',
  },
  {
    tier: 'Tier 2 • Caution',
    tierColor: 'amber',
    pkg: 'com.samsung.android.bixby.agent',
    name: 'Samsung Bixby Voice',
    type: 'OEM Assistant',
    action: 'Review First',
  },
  {
    tier: 'Tier 3 • Advanced',
    tierColor: 'orange',
    pkg: 'com.samsung.android.honeyboard',
    name: 'Stock Samsung Keyboard',
    type: 'Keyboard / Input',
    action: 'Power Users',
  },
  {
    tier: 'Tier 4 • Critical',
    tierColor: 'rose',
    pkg: 'com.android.systemui',
    name: 'Android System UI',
    type: 'Core OS Framework',
    action: '⛔ Hard-Blocked',
  },
];

const WIN_CMD = 'irm https://debloater.rovoxia.com/run.ps1 | iex';
const UNIX_CMD = 'curl -sSL https://debloater.rovoxia.com/run.sh | bash';

// Read master prompt content for AI Agent 1-click copy
let masterPrompt = '';
try {
  const promptPathWeb = path.resolve(process.cwd(), '..', 'prompt', 'master-prompt.md');
  const promptPathRoot = path.resolve(process.cwd(), 'prompt', 'master-prompt.md');
  const finalPromptPath = fs.existsSync(promptPathWeb) ? promptPathWeb : promptPathRoot;
  masterPrompt = fs.readFileSync(finalPromptPath, 'utf8').trim();
} catch (e) {
  masterPrompt = 'You are an expert Android systems engineer and mobile OS debloating specialist. Guide me through safely debloating my connected Android device with 100% reversible execution, using the official repository: https://github.com/Rovoxia/AI-Phone-Debloater.git';
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Rovoxia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={CANONICAL_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:site_name" content="AI Phone Debloater" />
    <meta property="og:image" content={`${SITE_URL}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.svg`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- JSON-LD Structured Data for SEO & AEO (Google / Bing / Perplexity / ChatGPT Search) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "SoftwareApplication",
            "name": "AI Phone Debloater",
            "operatingSystem": "Android, Windows, macOS, Linux",
            "applicationCategory": "UtilitiesApplication",
            "description": "The safe, open-source Android debloater and bloatware remover powered by AI agent master prompts, automated CLI, and WebApp workspace with 320+ curated OEM safety rules.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "url": "https://debloater.rovoxia.com"
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What are the benefits of debloating an Android phone?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Frees 1.5GB–3GB+ RAM, boosts battery 20–30%, reduces heat, and stops background carrier and OEM telemetry."
                }
              },
              {
                "@type": "Question",
                "name": "Why use AI Phone Debloater instead of other debloating tools?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Combines 1-click AI agent analysis, zero-install terminal runners, 61 hard-blocked core packages, auto-rollback snapshots, and 100% reversible execution."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need root access to debloat my phone?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Runs 100% rootless via ADB User 0. Bootloader stays locked, Knox stays 0x0, warranty remains valid, and banking apps keep working."
                }
              },
              {
                "@type": "Question",
                "name": "What are the safety best practices and data backup recommendations?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Uses non-destructive User 0 commands with 61 OS packages hard-blocked. Because OEM skins vary, always backup important photos and data before modifying Tier 2 or Tier 3 packages."
                }
              },
              {
                "@type": "Question",
                "name": "Can I restore an uninstalled app later?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Restore any app instantly via 'cmd package install-existing <package>' or with 1-click snapshot restore."
                }
              },
              {
                "@type": "Question",
                "name": "Will debloating affect OTA system software updates?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Operates in User 0 without touching read-only system partitions (dm-verity intact). Official OTA updates install normally."
                }
              }
            ]
          }
        ]
      }
    </script>

    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-[#0b0f17] dark:text-slate-100 font-sans antialiased min-h-screen selection:bg-emerald-500 selection:text-white">

    <Navbar />

    <main>
      <!-- HERO SECTION: Priority #1 AI Prompt -->
      <section id="ai-prompt" class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
        <!-- Subtle Glow Background -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[380px] bg-emerald-500/10 blur-[130px] rounded-full pointer-events-none -z-10 dark:bg-emerald-500/15"></div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

          <!-- Top Badges -->
          <div class="flex flex-wrap items-center justify-center gap-2.5 mb-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-400 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Let AI Do It (1-Click Prompt)
            </div>
            <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 text-xs font-bold shadow-2xs">
              <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>100% No Root Required • Warranty Safe</span>
            </div>
          </div>

          <!-- Main Title -->
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6">
            Debloat Your Phone <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-500 to-cyan-500">
              on Autopilot.
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed font-normal">
            Paste our official master prompt into Claude Code, Cursor, ChatGPT, Gemini, or Copilot. Your AI agent safely scans, classifies, and debloats your phone with 100% reversible execution.
          </p>

          <!-- Primary Actions -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-10">
            <!-- 1-Click Master Prompt Copy Button (Primary CTA) -->
            <button
              type="button"
              id="copy-master-prompt-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base shadow-lg shadow-emerald-600/25 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer group"
              data-prompt={masterPrompt}
              title="Copy Master Prompt for Claude Code, ChatGPT, Cursor, etc."
            >
              <svg class="w-5 h-5 text-emerald-200 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
              </svg>
              <span id="copy-prompt-btn-text">Copy Master AI Prompt</span>
            </button>

            <!-- Jump to Run via CLI (Instant) -->
            <a
              href="#cli"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-base transition-colors shadow-xs"
            >
              <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Run via CLI (Instant)</span>
            </a>

            <!-- Jump to Use the Web App (GUI) -->
            <a
              href="#webapp"
              class="relative w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-base transition-colors shadow-xs"
            >
              <span class="absolute -top-2 -right-2 px-1.5 py-0.5 rounded-full bg-amber-400 text-slate-950 text-[9px] font-black uppercase tracking-wider shadow-sm">Beta</span>
              <svg class="w-5 h-5 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
              <span>Use WebApp (GUI)</span>
            </a>
          </div>

          <!-- Compatibility Badges -->
          <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-slate-500 dark:text-slate-400">
            <span class="font-medium text-slate-700 dark:text-slate-300 mr-1">Supported AI Agents:</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">Claude Code</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">Cursor</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">ChatGPT</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">Gemini</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">Cline</span>
            <span class="px-2.5 py-1 rounded-md bg-slate-200/70 dark:bg-slate-800 font-mono text-slate-700 dark:text-slate-300">Windsurf</span>
          </div>

        </div>
      </section>

      <!-- Trust & Guarantees Bar -->
      <section class="border-y border-slate-200 dark:border-slate-800/80 bg-white dark:bg-[#0f131c] py-7">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div>
              <div class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400">100%</div>
              <div class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-1">No Root Required</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-slate-900 dark:text-white">{totalRules}+</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Verified OEM Rules</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-slate-900 dark:text-white">100%</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Reversible & Safe</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-slate-900 dark:text-white">1-Click</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Instant Rollback Backup</div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURES & BENEFITS SECTION (Full SEO & AEO Ready) -->
      <section id="features" class="py-20 md:py-28 relative">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

          <!-- Section Header -->
          <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-400 text-xs font-semibold mb-3">
              Features &amp; Benefits
            </div>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-4">
              Why Debloat Android &amp; Why Choose <br class="hidden sm:inline" />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">AI Phone Debloater</span>
            </h2>
            <p class="text-slate-600 dark:text-slate-300 text-base md:text-lg leading-relaxed">
              Modern OEM phones ship with 50+ background daemons, ad-tracking frameworks, and redundant bloatware apps that drain battery and slow your device down. Here is how debloating transforms your phone.
            </p>
          </div>

          <!-- PART 1: The Core Benefits of Debloating Android (4 Cards Grid) -->
          <div class="mb-20">
            <div class="flex items-center justify-between mb-8 pb-3 border-b border-slate-200 dark:border-slate-800">
              <div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">Core Benefits of Debloating Your Android</h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">Measurable real-world gains on battery, performance, and privacy</p>
              </div>
              <span class="hidden sm:inline-block text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">Zero-Risk Gains</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <!-- Benefit 1: Battery Life -->
              <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#121620] p-6 shadow-xs flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
                <div>
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 mb-4">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="2" y="7" width="16" height="10" rx="2" ry="2" />
                      <line x1="20" y1="11" x2="20" y2="13" />
                      <line x1="6" y1="10" x2="6" y2="14" />
                      <line x1="10" y1="10" x2="10" y2="14" />
                    </svg>
                  </div>
                  <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">+20% to 30% Battery Life</h4>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Terminates persistent wakelocks, carrier sync services, and silent analytics loops that drain battery while your screen is off.
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400 flex items-center gap-1.5">
                  <span>⚡ Up to 2-3 hrs extra screen-on time</span>
                </div>
              </div>

              <!-- Benefit 2: RAM & Performance -->
              <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#121620] p-6 shadow-xs flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
                <div>
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-500/10 text-teal-600 dark:text-teal-400 mb-4">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">1.5GB–3GB RAM Reclaimed</h4>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Stops heavy OEM background daemons (Bixby, Mi AI, Facebook services) from hoarding RAM, eliminating UI stutters and lag.
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-[11px] font-semibold text-teal-700 dark:text-teal-400 flex items-center gap-1.5">
                  <span>🚀 Instant multitasking responsiveness</span>
                </div>
              </div>

              <!-- Benefit 3: Privacy & Telemetry -->
              <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#121620] p-6 shadow-xs flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
                <div>
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 mb-4">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                  </div>
                  <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">Block Silent Telemetry</h4>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Cuts off pre-installed diagnostic uploaders, behavioral trackers, and adware frameworks that transmit your usage without consent.
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-[11px] font-semibold text-blue-700 dark:text-blue-400 flex items-center gap-1.5">
                  <span>🔒 Zero background analytics pings</span>
                </div>
              </div>

              <!-- Benefit 4: Storage & Clutter -->
              <div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-[#121620] p-6 shadow-xs flex flex-col justify-between hover:border-emerald-500/40 transition-colors">
                <div>
                  <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-4">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  </div>
                  <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">Zero App Clutter</h4>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Removes duplicate manufacturer app stores, carrier games, unremovable demo apps, and redundant system viewers cleanly.
                  </p>
