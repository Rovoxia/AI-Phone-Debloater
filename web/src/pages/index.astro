---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';

const SITE_URL = 'https://debloater.rovoxia.com';
const CANONICAL_URL = `${SITE_URL}/`;
const TITLE = 'AI Phone Debloater — The Safe, Open-Source Android Debloater';
const DESCRIPTION = 'Clean Android bloatware safely without root. Automated AI prompts, powerful CLI tools, and visual WebApp powered by 352 curated OEM rules across 10 databases. 100% reversible, automated backups, instant rollbacks.';
const KEYWORDS = 'AI Phone Debloater, Android debloater, bloatware remover, ADB debloat, Samsung debloat, Xiaomi debloat, rootless debloater';

const totalRules = 352;

// Curated representative rules across safety tiers
const sampleRules = [
  {
    tier: 'Tier 1 • Safe',
    tierColor: 'emerald',
    pkg: 'com.miui.msa.global',
    name: 'Xiaomi Ad Daemon',
    type: 'Adware & Telemetry',
    action: 'Safe to Disable',
  },
  {
    tier: 'Tier 2 • Caution',
    tierColor: 'amber',
    pkg: 'com.samsung.android.bixby.agent',
    name: 'Samsung Bixby Voice',
    type: 'OEM Assistant',
    action: 'Review First',
  },
  {
    tier: 'Tier 3 • Advanced',
    tierColor: 'orange',
    pkg: 'com.samsung.android.honeyboard',
    name: 'Stock Samsung Keyboard',
    type: 'Keyboard / Input',
    action: 'Power Users',
  },
  {
    tier: 'Tier 4 • Critical',
    tierColor: 'rose',
    pkg: 'com.android.systemui',
    name: 'Android System UI',
    type: 'Core OS Framework',
    action: '⛔ Hard-Blocked',
  },
];

const WIN_CMD = 'irm https://debloater.rovoxia.com/run.ps1 | iex';
const UNIX_CMD = 'curl -sSL https://debloater.rovoxia.com/run.sh | bash';
const WIN_BRIDGE_CMD = 'irm https://debloater.rovoxia.com/bridge.ps1 | iex';
const UNIX_BRIDGE_CMD = 'curl -sSL https://debloater.rovoxia.com/bridge.sh | bash';

// Read master prompt content for AI Agent 1-click copy
let masterPrompt = '';
try {
  const promptPathWeb = path.resolve(process.cwd(), '..', 'prompt', 'master-prompt.md');
  const promptPathRoot = path.resolve(process.cwd(), 'prompt', 'master-prompt.md');
  const finalPromptPath = fs.existsSync(promptPathWeb) ? promptPathWeb : promptPathRoot;
  masterPrompt = fs.readFileSync(finalPromptPath, 'utf8').trim();
} catch (e) {
  masterPrompt = 'You are an expert Android systems engineer and mobile OS debloating specialist. Guide me through safely debloating my connected Android device with 100% reversible execution, using the official repository: https://github.com/Rovoxia/AI-Phone-Debloater.git';
}
---

<!doctype html>
<html lang="en" class="scroll-smooth" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Rovoxia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={CANONICAL_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:site_name" content="AI Phone Debloater" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Phone-Debloater Architecture & 4-Tier Safety Flow" />
    <meta property="og:image" content={`${SITE_URL}/og-image.jpg`} />
    <meta property="og:image:secure_url" content={`${SITE_URL}/og-image.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Phone-Debloater Architecture & 4-Tier Safety Flow" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="debloater.rovoxia.com" />
    <meta property="twitter:domain" content="debloater.rovoxia.com" />
    <meta name="twitter:url" content={CANONICAL_URL} />
    <meta property="twitter:url" content={CANONICAL_URL} />
    <meta name="twitter:title" content={TITLE} />
    <meta property="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta property="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:src" content={`${SITE_URL}/og-image.png`} />
    <meta property="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:alt" content="AI-Phone-Debloater Architecture & 4-Tier Safety Flow" />
    <meta property="twitter:image:alt" content="AI-Phone-Debloater Architecture & 4-Tier Safety Flow" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>

    <!-- JSON-LD Structured Data (Google / Bing / Perplexity / ChatGPT Search / AI Overviews) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://debloater.rovoxia.com/#website",
            "url": "https://debloater.rovoxia.com/",
            "name": "AI Phone Debloater",
            "description": "Universal rootless Android debloater and bloatware removal engine powered by Python and ADB.",
            "publisher": {
              "@type": "Organization",
              "name": "Rovoxia",
              "url": "https://rovoxia.com",
              "logo": {
                "@type": "ImageObject",
                "url": "https://debloater.rovoxia.com/favicon.svg"
              }
            },
            "inLanguage": "en-US"
          },
          {
            "@type": "SoftwareApplication",
            "@id": "https://debloater.rovoxia.com/#application",
            "name": "AI Phone Debloater",
            "operatingSystem": "Android 8.0 - 15+, Windows, macOS, Linux",
            "applicationCategory": "UtilitiesApplication",
            "softwareVersion": "1.1.1",
            "description": "The safe, open-source Android debloater and bloatware remover powered by AI agent master prompts, automated CLI, and WebApp workspace with 352 curated OEM safety rules and 89 hard-blocked core packages.",
            "offers": {
              "@type": "Offer",
              "price": "0",
              "priceCurrency": "USD"
            },
            "url": "https://debloater.rovoxia.com",
            "image": "https://debloater.rovoxia.com/og-image.png",
            "screenshot": "https://debloater.rovoxia.com/og-image.png",
            "author": {
              "@type": "Organization",
              "name": "Rovoxia",
              "url": "https://rovoxia.com"
            }
          },
          {
            "@type": "HowTo",
            "name": "How to Debloat Android Without Root",
            "description": "Safely disable carrier and OEM bloatware on Android using standard ADB User 0 commands with 100% reversible execution.",
            "totalTime": "PT5M",
            "step": [
              {
                "@type": "HowToStep",
                "position": 1,
                "name": "Enable USB Debugging",
                "text": "Open Android Settings, navigate to About Phone, tap Build Number 7 times to enable Developer Options, then toggle USB Debugging ON."
              },
              {
                "@type": "HowToStep",
                "position": 2,
                "name": "Connect Device via ADB",
                "text": "Connect your phone to your computer via USB cable or Wireless ADB. Verify connection with adb devices."
              },
              {
                "@type": "HowToStep",
                "position": 3,
                "name": "Run Dry-Run Simulation",
                "text": "Run python cli/src/debloat_engine.py --tier 1 --dry-run to preview affected bloatware packages without making changes."
              },
              {
                "@type": "HowToStep",
                "position": 4,
                "name": "Apply Safe Debloat Action",
                "text": "Execute python cli/src/debloat_engine.py --tier 1 --action disable to safely freeze bloatware while retaining private user data."
              }
            ]
          },
          {
            "@type": "FAQPage",
            "mainEntity": [
              {
                "@type": "Question",
                "name": "What are the benefits of debloating an Android phone?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Frees 1.5GB–3GB+ RAM, boosts battery 20–30%, reduces heat, and stops background carrier and OEM telemetry."
                }
              },
              {
                "@type": "Question",
                "name": "Why use AI Phone Debloater instead of other debloating tools?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Combines 1-click AI agent analysis, zero-install terminal runners, 89 hard-blocked core packages, auto-rollback snapshots, and 100% reversible execution."
                }
              },
              {
                "@type": "Question",
                "name": "Do I need root access to debloat my phone?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Runs 100% rootless via ADB User 0. Bootloader stays locked, Knox stays 0x0, warranty remains valid, and banking apps keep working."
                }
              },
              {
                "@type": "Question",
                "name": "What are the safety best practices and data backup recommendations?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Uses non-destructive User 0 commands with 89 OS packages hard-blocked. Because OEM skins vary, always backup important photos and data before modifying Tier 2 or Tier 3 packages."
                }
              },
              {
                "@type": "Question",
                "name": "Can I restore an uninstalled app later?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "Yes. Restore any app instantly via 'cmd package install-existing <package>' or with 1-click snapshot restore."
                }
              },
              {
                "@type": "Question",
                "name": "Will debloating affect OTA system software updates?",
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": "No. Operates in User 0 without touching read-only system partitions (dm-verity intact). Official OTA updates install normally."
                }
              }
            ]
          }
        ]
      }
    </script>

    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-[#0b0f17] dark:text-slate-100 font-sans antialiased min-h-screen selection:bg-emerald-500 selection:text-white">

    <Navbar />

    <main>
      <!-- HERO SECTION: Priority #1 AI Prompt with Viewport-Fitted Bottom Stats -->
      <section id="ai-prompt" class="relative min-h-[calc(100vh-4rem)] flex flex-col justify-between overflow-hidden">
        <!-- Subtle Architectural Engineering Grid Background with Radial Mask Fade -->
        <div
          class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a08_1px,transparent_1px),linear-gradient(to_bottom,#0f172a08_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_70%,transparent_100%)] pointer-events-none -z-10"
          aria-hidden="true"
        ></div>

        <!-- 5. Subtle Top Radial Glow -->
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[320px] bg-[radial-gradient(45%_40%_at_50%_0%,rgba(16,185,129,0.07),transparent_100%)] pointer-events-none -z-10"
          aria-hidden="true"
        ></div>

        <!-- Subtle Glow Background -->
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[360px] bg-emerald-500/10 blur-[130px] rounded-full pointer-events-none -z-10 dark:bg-emerald-500/15" aria-hidden="true"></div>

        <!-- Hero Content Container (Expanded Presence & Width) -->
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-5 sm:pt-7 md:pt-8 pb-4 my-auto w-full">

          <!-- 2. Consolidated Compound Announcement Pill -->
          <div class="inline-flex items-center gap-2 p-1 pr-3.5 rounded-full border border-slate-200/90 bg-white/90 dark:border-slate-800 dark:bg-slate-900/80 backdrop-blur-md shadow-xs text-xs mb-3.5 sm:mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-500/25">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
              352 OEM Rules
            </span>
            <span class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-300 font-medium text-xs">
              <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
              <span>100% Rootless ADB &bull; Warranty-Safe Execution</span>
            </span>
          </div>

          <!-- 3. Headline with Precise Typography & Gradient -->
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-extrabold tracking-[-0.035em] text-slate-900 dark:text-white leading-[1.12] mb-3">
            Debloat Your Phone <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">
              on Autopilot.
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-4 leading-relaxed font-normal">
            Paste our official master prompt into Claude Code, Cursor, ChatGPT, Gemini, or Copilot. Your AI agent safely scans, classifies, and debloats your phone with 100% reversible execution.
          </p>

          <div id="master-prompt" class="scroll-mt-24"></div>

          <!-- 4. Upgraded CTA Button Hierarchy -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-4">
            <!-- Primary CTA: High-craft Emerald button with inner top highlight & copy feedback -->
            <button
              type="button"
              id="copy-master-prompt-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-xl border-t border-white/30 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-600/35 transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer group"
              data-prompt={masterPrompt}
              title="Copy Master Prompt for Claude Code, ChatGPT, Cursor, etc."
            >
              <svg class="w-4.5 h-4.5 text-emerald-200 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
              </svg>
              <span id="copy-prompt-btn-text">Copy Master AI Prompt</span>
            </button>

            <!-- Secondary CTA: Clean slate-bordered button with terminal icon -->
            <a
              href="#cli"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-sm transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5" />
                <line x1="12" y1="19" x2="20" y2="19" />
              </svg>
              <span>Run via CLI</span>
            </a>

            <!-- Third Option: Use WebApp GUI with subtle inline pill inside -->
            <a
              href="/app"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-sm transition-colors shadow-xs"
            >
              <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
              <span>Use WebApp (WebADB)</span>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold tracking-wide border border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">
                Live
              </span>
            </a>
          </div>

          <!-- 5. Refined Monochrome Engineering Pills for Supported AI Agents -->
          <div class="flex flex-wrap items-center justify-center gap-2 text-xs mb-4">
            <span class="font-medium text-slate-500 dark:text-slate-400 mr-1">Works natively with:</span>
            {['Claude Code', 'Cursor', 'ChatGPT', 'Gemini', 'Cline', 'Windsurf'].map((agent) => (
              <span class="px-2.5 py-1 rounded-md bg-slate-50 border border-slate-200/90 font-medium text-slate-700 hover:border-slate-300 hover:bg-white dark:bg-slate-900/60 dark:border-slate-800 dark:text-slate-300 dark:hover:border-slate-700 transition shadow-2xs">
                {agent}
              </span>
            ))}
          </div>

          <!-- 6. Enterprise Live Terminal / AI Audit Preview Window with Bezel Frame -->
          <div class="max-w-3xl mx-auto p-2 rounded-2xl bg-slate-900/[0.03] border border-slate-200/80 shadow-sm">
            <div class="rounded-xl border border-slate-800/80 bg-[#090D16] shadow-2xl shadow-slate-950/20 text-left overflow-hidden">
              <!-- Terminal Header -->
              <div class="flex items-center justify-between px-3.5 py-2 border-b border-white/[0.08] bg-white/[0.02]">
                <div class="flex items-center gap-1.5 shrink-0">
                  <div class="w-3 h-3 rounded-full bg-[#ff5f56]/90 border border-[#e0443e]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#ffbd2e]/90 border border-[#dea123]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#27c93f]/90 border border-[#1aab29]"></div>
                </div>
                <div class="font-mono text-[11px] text-slate-400 font-medium tracking-tight truncate px-2">
                  bash &mdash; adb audit &amp; debloat engine (user-0)
                </div>
                <div class="shrink-0">
                  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    READ/WRITE: USER-0 SAFE
                  </span>
                </div>
              </div>

              <!-- Terminal Body -->
              <div class="p-3.5 sm:p-4 font-mono text-xs leading-relaxed space-y-1.5 select-text overflow-x-auto">
                <!-- Line 1 -->
                <div class="flex items-center gap-2 whitespace-nowrap">
                  <span class="text-emerald-400 font-semibold">$</span>
                  <span class="text-slate-200">adb devices</span>
                  <span class="text-slate-500">&rarr;</span>
                  <span class="text-emerald-400 font-medium">1 device connected</span>
                  <span class="text-slate-400">(Xiaomi HyperOS 2.0)</span>
                </div>
                <!-- Line 2 -->
                <div class="text-slate-400 whitespace-nowrap flex items-center gap-1.5">
                  <span>🤖</span>
                  <span>AI Agent auditing 284 installed system packages against 352 OEM rules...</span>
                </div>
                <!-- Line 3 -->
                <div class="whitespace-nowrap">
                  <span class="text-emerald-400 font-semibold">[SAFE TO REMOVE]</span>
                  <span class="text-slate-200"> com.miui.analytics, com.miui.msa.global</span>
                  <span class="text-slate-500"> (Ad Daemon &amp; Telemetry)</span>
                </div>
                <!-- Line 4 -->
                <div class="whitespace-nowrap">
                  <span class="text-amber-400 font-semibold">[PROTECTED]</span>
                  <span class="text-slate-200"> com.xiaomi.finddevice, com.android.systemui</span>
                  <span class="text-slate-500"> (Core System &mdash; Skipped)</span>
                </div>
                <!-- Line 5: Completion Line -->
                <div class="whitespace-nowrap text-emerald-400 font-medium pt-1.5 border-t border-white/[0.08]">
                  <span class="font-bold">&check;</span> 18 bloatware &amp; telemetry packages safely disabled in 4.2s <span class="text-slate-400">(Rollback backup saved)</span>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- 7. Upgraded 4-Column Metrics Bar (Docked at Bottom Edge of Hero Screen) -->
        <div class="w-full border-t border-b border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-[#0f131c]/95 backdrop-blur-md py-3.5 sm:py-4 shrink-0 mt-auto relative z-10">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-slate-200 dark:divide-slate-800/80 text-center">
