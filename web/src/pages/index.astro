    <!-- Copy Buttons Logic -->
    <script>
      // CLI & Generic copy buttons
      const copyBtns = document.querySelectorAll('.copy-btn');
      copyBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-cmd') || '';
          try {
            await navigator.clipboard.writeText(cmd);
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<span class="text-emerald-400 font-bold">✓ Copied!</span>';
            setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
          } catch {
            prompt('Copy this command:', cmd);
          }
        });
      });

      // Master Prompt Copy Buttons (Hero + Card + Footer)
      const setupPromptCopy = (selector: string, textSelector?: string) => {
        const buttons = document.querySelectorAll(selector);
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const text = btn.getAttribute('data-prompt') || '';
            try {
              await navigator.clipboard.writeText(text);
              const labelEl = textSelector ? btn.querySelector(textSelector) : btn;
              if (labelEl) {
                const originalText = labelEl.textContent;
                labelEl.textContent = '✓ Copied Prompt!';
                setTimeout(() => {
                  labelEl.textContent = originalText;
                }, 2500);
              }
            } catch {
              prompt('Copy AI Agent Prompt:', text);
            }
          });
        });
      };

      setupPromptCopy('#copy-master-prompt-btn', '#copy-prompt-btn-text');
      setupPromptCopy('.secondary-prompt-copy-btn');
      setupPromptCopy('.footer-prompt-copy-btn');
    </script>
