---
// Home page. Every count on it is read from rules-dataset.json (through tiers.ts where a tier is
// involved) and the version from version.ts; nothing is typed. The FAQ and its FAQPage JSON-LD
// both come from src/data/faq.ts.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import CopyButton from '../components/CopyButton.astro';
import Icon from '../components/Icon.astro';
import TierBadge from '../components/TierBadge.astro';
import type { IconName } from '../lib/icons';
import rulesData from '../data/rules-dataset.json';
import { BRANDS, type Brand } from '../data/brands';
import { FAQ } from '../data/faq';
import { REMOVABLE_TIERS, RULE_STATS, TIERS, TIER_3_RULE, tierFor, type TierId } from '../data/tiers';
import { SITE_VERSION } from '../lib/version';
import { GITHUB_REPO, SITE_URL, faqNode, softwareApplicationNode } from '../lib/seo';

const { rules } = rulesData;

/* ---- Head ---------------------------------------------------------------- */

const TITLE = 'Android Debloater Without Root (ADB) | AI Phone Debloater';
const DESCRIPTION = `Open-source Android debloater that removes bloatware over ADB without root. ${RULE_STATS.total} curated rules, ${RULE_STATS.critical} protected system packages and a snapshot before every change.`;

// The definition under the <h1>. It names the product, so it stands alone when quoted, and it is
// also the SoftwareApplication description.
const DEFINITION = `AI Phone Debloater is a free, open-source Android debloater. It disables or uninstalls preinstalled apps over ADB for one user profile, without root, an unlocked bootloader or any write to the system partition. It matches installed packages against ${RULE_STATS.removable} removal rules in three safety tiers, refuses to touch ${RULE_STATS.critical} critical system packages, and saves a restore snapshot before every change.`;

/* ---- Master prompt (read at build time, embedded once) ------------------- */

const promptPath = [
  path.resolve(process.cwd(), '..', 'prompt', 'master-prompt.md'),
  path.resolve(process.cwd(), 'prompt', 'master-prompt.md'),
].find((candidate) => fs.existsSync(candidate));
if (!promptPath) {
  throw new Error('src/pages/index.astro: prompt/master-prompt.md was not found, so the copy buttons would have nothing to copy.');
}
const masterPrompt = fs.readFileSync(promptPath, 'utf8').trim();
// The prompt's own step headings ("## Step 1: Set up and connect"), shown as its outline.
const promptSteps = [...masterPrompt.matchAll(/^## Step \d+: (.+)$/gm)].map((match) => match[1].trim());

/* ---- Commands ------------------------------------------------------------ */

interface Command {
  shell: string;
  /** What a screen reader hears after "Copy". */
  name: string;
  text: string;
}

const cliCommands: Command[] = [
  { shell: 'Windows PowerShell', name: 'the PowerShell install command', text: `irm ${SITE_URL}/run.ps1 | iex` },
  { shell: 'macOS and Linux', name: 'the macOS and Linux install command', text: `curl -fsSL ${SITE_URL}/run.sh | bash` },
];

const bridgeCommands: Command[] = [
  { shell: 'Windows PowerShell', name: 'the PowerShell bridge command', text: `irm ${SITE_URL}/bridge.ps1 | iex` },
  { shell: 'macOS and Linux', name: 'the macOS and Linux bridge command', text: `curl -fsSL ${SITE_URL}/bridge.sh | bash` },
];

// Wording follows `python cli/src/debloat_engine.py --help`.
const cliFlags: { flag: string; text: string }[] = [
  { flag: '--scan', text: 'Scan the phone and classify the installed packages.' },
  { flag: '--tier 1|2|3', text: 'Plan that tier only. Tier 2 does not include Tier 1.' },
  { flag: '--package NAME', text: 'Limit the plan to one package. Repeat it for more. Critical packages are refused.' },
  { flag: '--action disable|uninstall', text: 'What to do with the planned packages. The default is disable.' },
  { flag: '--dry-run', text: 'Print the plan and change nothing.' },
  { flag: '--restore [SNAPSHOT]', text: 'Restore a snapshot: the newest one if no name is given.' },
  { flag: '--list-snapshots', text: 'List snapshots, newest first. No phone needed.' },
];

interface CodeLine {
  text: string;
  comment?: boolean;
}

const restoreCliLines: CodeLine[] = [
  { text: '# Restore the newest snapshot of the connected phone', comment: true },
  { text: 'python cli/src/debloat_engine.py --restore' },
  { text: '# List snapshots, then restore one by name', comment: true },
  { text: 'python cli/src/debloat_engine.py --list-snapshots' },
  { text: 'python cli/src/debloat_engine.py --restore <snapshot>' },
];

const restoreAdbLines: CodeLine[] = [
  { text: '# A package that was disabled', comment: true },
  { text: 'adb shell pm enable --user 0 <package>' },
  { text: '# A package that was uninstalled for the user', comment: true },
  { text: 'adb shell cmd package install-existing --user 0 <package>' },
];

/* ---- Rules: one example per tier, and counts per brand ------------------- */

const SAMPLE_PACKAGES: Record<TierId, string> = {
  1: 'com.miui.msa.global',
  2: 'com.samsung.android.spay',
  3: TIER_3_RULE.package,
  4: 'com.android.systemui',
};

// The preferred package if the rule set still has it in that tier, else the tier's first rule.
const sampleRules = TIERS.map(
  (tier) =>
    rules.find((rule) => rule.package === SAMPLE_PACKAGES[tier.id] && tierFor(rule.tier).id === tier.id) ??
    rules.find((rule) => tierFor(rule.tier).id === tier.id),
).filter((rule) => rule !== undefined);

const actionLabel = (action: string): string =>
  action === 'disable' || action === 'uninstall' ? `Recommended: ${action}` : 'Never changed';

// The brand groups of the rule set, with names, paths and counts from src/data/brands.ts.
// The critical list is not a brand: it has its own sentence under the table.
const brands = BRANDS.filter((brand) => !brand.critical);
const brandFileCount = brands.filter((brand) => brand.id !== 'universal').length;
const tierCountOf = (brand: Brand, tierId: TierId): number =>
  brand.tiers.find((entry) => entry.tier.id === tierId)?.count ?? 0;

if (brands.reduce((sum, brand) => sum + brand.count, 0) !== RULE_STATS.removable) {
  throw new Error('src/pages/index.astro: the per-brand rule counts do not add up to the removal rules in rules-dataset.json.');
}

/* ---- Static content ------------------------------------------------------ */

const stats: { value: number; label: string }[] = [
  { value: RULE_STATS.removable, label: 'removal rules in three safety tiers' },
  { value: RULE_STATS.critical, label: 'critical system packages it refuses to touch' },
  { value: brandFileCount, label: 'phone-brand rule files, plus the universal rules' },
];

// `html` is static, trusted markup (inline <code> only).
const promptAnnouncement = 'The AI agent prompt is on the clipboard.';
const commandAnnouncement = 'The command is on the clipboard.';

const facts: { icon: IconName; title: string; html: string }[] = [
  {
    icon: 'shield-check',
    title: 'No root, no bootloader unlock',
    html: 'It talks to the phone over ADB, the debugging interface Android already has. It needs no root access and no unlocked bootloader, and it never writes to the system partition.',
  },
  {
    icon: 'terminal',
    title: 'Two package-manager commands',
    html: 'It disables a package with <code class="code">pm disable-user</code>, or uninstalls it for one Android user with <code class="code">pm uninstall -k</code>, which keeps the app&#39;s data. That user is user 0 unless you choose another.',
  },
  {
    icon: 'rotate-ccw',
    title: 'A snapshot before every change',
    html: 'Before it changes anything, it records which packages are installed and enabled. If the snapshot cannot be saved, it stops without touching the phone.',
  },
  {
    icon: 'lock',
    title: `${RULE_STATS.critical} critical packages refused`,
    html: 'Core Android packages such as the framework, System UI, telephony and Google Play services are on a critical list. No tier, flag or prompt makes the tool disable or uninstall them.',
  },
];

const comparison: { label: string; cells: [string, string, string] }[] = [
  { label: 'Root access', cells: ['Not needed', 'Not needed', 'Required'] },
  { label: 'Unlocked bootloader', cells: ['Not needed', 'Not needed', 'Needed on most phones'] },
  { label: 'System partition', cells: ['Never written', 'Not written by these commands', 'Can be modified'] },
  {
    label: 'Choosing packages',
    cells: [`${RULE_STATS.removable} rules in three safety tiers`, 'You research each package', 'You research each package'],
  },
  {
    label: 'Critical system packages',
    cells: [`${RULE_STATS.critical} packages refused`, 'You check each one yourself', 'You check each one yourself'],
  },
  {
    label: 'Undo',
    cells: ['A snapshot is saved before every change', 'You keep your own record of what you changed', 'Depends on what was changed'],
  },
];

const guides: { href: string; icon: IconName; title: string; text: string }[] = [
  {
    href: '/blog/adb-debloat-safety-tiers-explained',
    icon: 'shield',
    title: 'Safety tiers explained',
    text: 'What each of the four tiers contains and which one to start with.',
  },
  {
    href: '/blog/wireless-adb-debloat-setup-android-11',
    icon: 'wifi',
    title: 'Wireless ADB setup',
    text: 'Pair and connect over Wi-Fi with wireless debugging on Android 11 and newer.',
  },
  {
    href: '/blog/samsung-galaxy-debloat-guide-one-ui-6',
    icon: 'smartphone',
    title: 'Samsung Galaxy debloat guide',
    text: 'The Samsung rules, tier by tier.',
  },
  {
    href: '/blog/xiaomi-hyperos-debloat-guide',
    icon: 'smartphone',
    title: 'Xiaomi HyperOS debloat guide',
    text: 'The Xiaomi rules, tier by tier.',
  },
  {
    href: '/blog/debloat-vs-factory-reset',
    icon: 'refresh-cw',
    title: 'Debloat or factory reset?',
    text: 'What each one changes on the phone, and when to use which.',
  },
  {
    href: '/blog',
    icon: 'book-open',
    title: 'All guides',
    text: 'Brand guides, ADB setup and the safety tiers, in one list.',
  },
];
---

<Base
  title={TITLE}
  titleTemplate={false}
  description={DESCRIPTION}
  path="/"
  jsonLd={[softwareApplicationNode(SITE_VERSION, DEFINITION), faqNode(FAQ)]}
>
  <!-- What it is -->
  <!-- The hero fills the first screen below the sticky header, up to a cap so that it is not a
       mostly empty band on tall or ultra-wide screens. svh, not vh: the mobile URL bar does not
       shift it. -->
  <section class="hero section grid min-h-[min(calc(100svh_-_var(--spacing-header)),50rem)] content-center">
    <div class="container-page grid justify-items-center gap-stack-lg">
      <div class="min-w-0 max-w-4xl text-center">
        <p class="flex flex-wrap justify-center gap-2">
          <span class="badge badge-accent">No root</span>
          <span class="badge">MIT License</span>
          <span class="badge badge-mono">v{SITE_VERSION}</span>
        </p>
        <h1 class="display mt-stack">
          The <span class="inline-block max-w-full">open-source</span> Android debloater
          <span class="text-gradient">that works without root</span>
        </h1>
        <p class="lead mx-auto mt-stack">{DEFINITION}</p>
        <div class="mt-stack-lg flex flex-wrap justify-center gap-3">
          <a href="/app" class="btn btn-primary btn-lg">
            <Icon name="monitor" />
            Open the web app
          </a>
          <CopyButton
            from="master-prompt"
            label="Copy the AI agent prompt"
            announce={promptAnnouncement}
            class="btn btn-secondary btn-lg"
          />
        </div>
        <p class="mt-stack text-sm text-muted">
          Prefer a terminal? <a href="#cli" class="link">Install the CLI with one command</a>.
        </p>
      </div>

      <figure class="card card-flush card-raised w-full max-w-3xl min-w-0">
        <figcaption class="window-bar border-b border-line bg-subtle px-5 py-3 text-sm font-semibold text-ink">
          One rule from each safety tier
        </figcaption>
        <ul class="divide-y divide-line">
          {
            sampleRules.map((rule) => (
              <li class="grid gap-1 px-5 py-4">
                <p class="flex flex-wrap items-center justify-between gap-2">
                  <TierBadge tier={rule.tier} />
                  <span class="meta">{actionLabel(rule.recommended_action)}</span>
                </p>
                <p class="mt-1 font-semibold text-ink">{rule.name}</p>
                <p class="pkg text-muted">{rule.package}</p>
              </li>
            ))
          }
        </ul>
        <p class="border-t border-line px-5 py-3 text-sm text-muted">
          Read from the rule set when this page was built.
          <a href="/oems" class="link">See all {RULE_STATS.total} rules</a>
        </p>
      </figure>
    </div>
  </section>

  <section class="section-sm section-alt" aria-label="The rule set in numbers">
    <div class="container-page">
      <ul class="grid-auto-sm text-center">
        {
          stats.map((stat) => (
            <li>
              <p class="stat-value">{stat.value}</p>
              <p class="stat-label">{stat.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="what" class="section">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">What it does</p>
        <h2 class="h2">What AI Phone Debloater does to a phone</h2>
        <p class="lead">
          It changes whether a preinstalled app is enabled or installed for one Android user. It does nothing else: no
          flashing, no root shell, no change to the system partition.
        </p>
      </div>

      <ul class="grid-auto">
        {
          facts.map((fact) => (
            <li class="card">
              <Icon name={fact.icon} class="size-6 text-accent" />
              <h3 class="h4 mt-4">{fact.title}</h3>
              <p class="mt-2 text-sm text-muted" set:html={fact.html} />
            </li>
          ))
        }
      </ul>

      <div class="callout mt-stack-lg" role="note">
        <Icon name="info" />
        <div class="max-w-measure">
          <p class="callout-title">What it does not do</p>
          <p>
            It does not back up your photos, chats or files: a snapshot holds package states only. It does not measure
            memory or battery use, so this site publishes no performance figures. And turning off an app can take a
            feature you use with it, which is why every change can be restored.
          </p>
        </div>
      </div>

      <h3 class="h3 mt-section-sm">Compared with manual ADB commands and rooting</h3>
      <p class="mt-3 max-w-measure text-muted">
        Manual ADB means typing the same <code class="code">pm</code> commands yourself. Rooting is a different approach
        that gives full write access to the phone.
      </p>
      <div class="table-wrap mt-stack" role="region" aria-label="Comparison with manual ADB commands and rooting" tabindex="0">
        <table class="table min-w-[44rem]">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">What is compared</span></th>
              <th scope="col">AI Phone Debloater</th>
              <th scope="col">Manual ADB commands</th>
              <th scope="col">Rooting</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td>{cell}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section section-alt">
    <div class="container-page grid gap-x-stack-lg lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 class="h2">How it works, in five steps</h2>
        <p class="lead">The steps are the same in the CLI, the web app and the AI agent prompt.</p>
      </div>

      <ol class="steps measure">
        <li>
          <h3 class="h4">Connect</h3>
          <p class="mt-1 text-muted">
            Turn on USB debugging on the phone and connect it by USB. The CLI can also connect over Wi-Fi; QR-code
            pairing needs Android 11 or newer. See
            <a href="#adb-setup" class="link">how to enable USB debugging</a> and the
            <a href="/blog/wireless-adb-debloat-setup-android-11" class="link">wireless ADB guide</a>.
          </p>
        </li>
        <li>
          <h3 class="h4">Scan</h3>
          <p class="mt-1 text-muted">
            The tool lists the packages installed for the Android user, reads the phone's manufacturer and loads the
            universal rules plus that brand's rule file. Each package it recognises gets a tier; the rest stay
            unclassified.
          </p>
        </li>
        <li>
          <h3 class="h4">Review the plan</h3>
          <p class="mt-1 text-muted">
            Choose a tier or individual packages. In the CLI, <code class="code">--dry-run</code> prints the plan and
            changes nothing. The web app has no dry run: it lists the packages in a confirmation dialog instead.
          </p>
        </li>
        <li>
          <h3 class="h4">Confirm</h3>
          <p class="mt-1 text-muted">
            Nothing changes until you confirm. The tool saves a snapshot of package states first and stops if it
            cannot. Then it disables each package with <code class="code">pm disable-user</code>, or uninstalls it for
            that user with <code class="code">pm uninstall -k</code>, which keeps the app's data. Critical packages are
            refused even if they were selected.
          </p>
        </li>
        <li>
          <h3 class="h4">Restore if needed</h3>
          <p class="mt-1 text-muted">
            If something you use stops working, restore the snapshot or bring back a single package.
            <a href="#undo" class="link">How to undo a change</a> has the commands.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Three ways to use it -->
  <section id="ways" class="section">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Get started</p>
        <h2 class="h2">Three ways to use it</h2>
        <p class="lead">
          All three use the same rules and the same two commands. Pick the one that fits how you work.
        </p>
      </div>

      <!-- One way of using the tool: text on the left, commands on the right from 64rem up. -->
      <article id="agent" class="grid gap-stack-lg border-t border-line py-stack-lg last:pb-0 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="min-w-0">
          <Icon name="code" class="size-6 text-accent" />
          <h3 class="h3 mt-3">AI agent prompt</h3>
          <p class="mt-3 text-muted">
            For an AI coding agent that can run terminal commands. Copy the master prompt, paste it into the agent, and
            the agent drives the CLI. The prompt tells it to:
          </p>
          <ul class="mt-stack grid gap-3 text-muted">
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>take each package's tier from the engine's scan, not from memory;</span>
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>show you the plan from a dry run and wait until you reply <code class="code">PROCEED</code>;</span>
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>never touch a Tier 4 package and never skip the snapshot.</span>
            </li>
          </ul>
          <p class="mt-stack text-muted">
            A chat-only assistant cannot run commands, so the prompt has it walk you through the web app or the CLI
            instead.
          </p>
        </div>
        <div class="card min-w-0 self-start">
          <p class="h4">What the prompt covers</p>
          {
            promptSteps.length > 0 && (
              <ol class="mt-3 grid gap-2 text-sm text-muted">
                {promptSteps.map((step, index) => (
                  <li class="flex gap-3">
                    <span class="font-mono text-faint">{index + 1}</span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            )
          }
          <div class="mt-stack flex flex-wrap gap-3">
            <CopyButton
              from="master-prompt"
              label="Copy the prompt"
              announce={promptAnnouncement}
              class="btn btn-secondary"
            />
            <a href="/prompt.md" class="btn btn-ghost">
              <Icon name="file-text" />
              Read the full prompt
            </a>
          </div>
        </div>
      </article>

      <article id="web-app" class="grid gap-stack-lg border-t border-line py-stack-lg last:pb-0 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="min-w-0">
          <Icon name="monitor" class="size-6 text-accent" />
          <h3 class="h3 mt-3">Web app</h3>
          <p class="mt-3 text-muted">
            Open the web app, connect the phone and work from a table of its packages. In a Chromium browser such as
            Chrome or Edge there is nothing to install: the page talks to the phone over WebUSB.
          </p>
          <ul class="mt-stack grid gap-3 text-muted">
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>
                Other browsers use the local bridge, a small server on your own computer at
                <code class="code">127.0.0.1:53123</code> that runs ADB for the page.
              </span>
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>Every change opens a confirmation dialog that lists the packages. There is no dry run.</span>
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-[0.3em] size-4 text-accent" />
              <span>A snapshot is saved in the browser before each change and can be restored from there.</span>
            </li>
          </ul>
          <p class="mt-stack-lg">
            <a href="/app" class="btn btn-secondary">
              Open the web app
              <Icon name="arrow-right" />
            </a>
          </p>
        </div>
        <div class="grid min-w-0 content-start gap-stack">
          <p class="max-w-measure text-sm text-muted">
            To use the local bridge, run one of these. It starts the bridge and opens the web app connected to it; press
            <kbd class="kbd">Ctrl</kbd> + <kbd class="kbd">C</kbd> in the terminal to stop it.
          </p>
          {
            bridgeCommands.map((command) => (
              <figure class="code-figure">
                <figcaption class="code-caption">
                  <span>{command.shell}</span>
                  <CopyButton text={command.text} name={command.name} announce={commandAnnouncement} />
                </figcaption>
                <pre class="code-block" tabindex="0"><code>{command.text}</code></pre>
              </figure>
            ))
          }
        </div>
      </article>

      <article id="cli" class="grid gap-stack-lg border-t border-line py-stack-lg last:pb-0 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="min-w-0">
          <Icon name="terminal" class="size-6 text-accent" />
          <h3 class="h3 mt-3">Command line (CLI)</h3>
          <p class="mt-3 text-muted">
            One command downloads the CLI into <code class="code">~/.ai-phone-debloater</code> and opens an interactive
            menu. The launcher looks for Python 3.11 or newer and for ADB, and tries to install them if they are missing.
            The CLI itself uses only the Python standard library.
          </p>
          <p class="mt-stack text-muted">
            Each command pipes a script into your shell, so read it first if you like:
            <a href="/run.ps1" class="link">run.ps1</a> and <a href="/run.sh" class="link">run.sh</a>. Or clone the
            <a href={GITHUB_REPO} class="link" target="_blank" rel="noopener noreferrer">repository on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
            and run the engine from there.
          </p>
        </div>
        <div class="grid min-w-0 content-start gap-stack">
          {
            cliCommands.map((command) => (
              <figure class="code-figure">
                <figcaption class="code-caption">
                  <span>{command.shell}</span>
                  <CopyButton text={command.text} name={command.name} announce={commandAnnouncement} />
                </figcaption>
                <pre class="code-block" tabindex="0"><code>{command.text}</code></pre>
              </figure>
            ))
          }
          <div class="card card-flush">
            <p class="border-b border-line bg-subtle px-5 py-3 text-sm text-muted">
              The flags you will use most. Run the engine with <code class="code">--help</code> for the
              rest.
            </p>
            <dl class="divide-y divide-line">
              {
                cliFlags.map((item) => (
                  <div class="grid gap-x-stack gap-y-1 px-5 py-3 sm:grid-cols-[minmax(0,15rem)_minmax(0,1fr)]">
                    <dt class="pkg font-semibold text-ink">{item.flag}</dt>
                    <dd class="text-sm text-muted">{item.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- The four safety tiers -->
  <section id="tiers" class="section section-alt">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Safety</p>
        <h2 class="h2">The four safety tiers</h2>
        <p class="lead">
          Every rule has a tier. Start with Tier 1. In the CLI, a plan covers exactly the tier you pick: Tier 2 never
          rides along with Tier 1, and a package that matches no rule is never part of a tier plan.
        </p>
      </div>

      <ul class="grid-auto">
        {
          TIERS.map((tier) => (
            <li class="card">
              <h3>
                <TierBadge tier={tier.id} />
              </h3>
              <p class="stat-value mt-4">{tier.count}</p>
              <p class="stat-label">{tier.removable ? (tier.count === 1 ? 'rule' : 'rules') : 'protected packages'}</p>
              <p class="mt-4 text-sm font-semibold text-ink">{tier.audience}</p>
              <p class="mt-2 text-sm text-muted">{tier.description}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-stack-lg text-muted">
        <a href="/blog/adb-debloat-safety-tiers-explained" class="link">Read the safety tiers guide</a>, or look up a
        package in the <a href="/oems" class="link">package list by OEM</a>.
      </p>
    </div>
  </section>

  <!-- What is covered -->
  <section id="brands" class="section">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Coverage</p>
        <h2 class="h2">Phone brands the rules cover</h2>
        <p class="lead">
          The tool reads the phone's manufacturer and loads the universal rules plus the matching brand file. If it does
          not recognise the manufacturer, it loads every brand file.
        </p>
      </div>

      <div class="table-wrap max-w-4xl" role="region" aria-label="Removal rules by brand" tabindex="0">
        <!-- The brand links are 44px tall, so the numbers are centred on them and the row padding
             the taller link makes unnecessary is trimmed. On a phone the five columns fit without
             sideways scrolling: tighter cells, and the tier headings shorten to T1, T2, T3. -->
        <table
          class="table max-sm:[&_:is(th,td)]:px-2 max-sm:[&_:is(th,td):first-child]:pl-4 max-sm:[&_:is(th,td):last-child]:pr-4 [&_tbody_:is(th,td)]:py-0.5 [&_tbody_:is(th,td)]:align-middle"
        >
          <caption>Removal rules by brand. Each brand links to its package list.</caption>
          <thead>
            <tr>
              <th scope="col">Brand</th>
              <th scope="col" class="num">Rules</th>
              {
                REMOVABLE_TIERS.map((tier) => (
                  <th scope="col" class="num">
                    <span class="sm:hidden" aria-hidden="true">T{tier.id}</span>
                    <span class="max-sm:sr-only">{tier.label}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              brands.map((brand) => (
                <tr data-brand={brand.id}>
                  <th scope="row">
                    <a href={brand.path} class="link inline-flex min-h-11 items-center">
                      {brand.name}
                    </a>
                  </th>
                  <td class="num">{brand.count}</td>
                  {REMOVABLE_TIERS.map((tier) => (
                    <td class="num">{tierCountOf(brand, tier.id)}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">All removal rules</th>
              <td class="num">{RULE_STATS.removable}</td>
              {REMOVABLE_TIERS.map((tier) => (
                <td class="num">{tier.count}</td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="mt-stack max-w-measure text-muted">
        The <a href="/oems/critical" class="link">critical list</a> adds {RULE_STATS.critical} packages that are never
        changed on any brand, which makes {RULE_STATS.total} rules in all.
      </p>
      <p class="mt-stack">
        <a href="/oems" class="btn btn-secondary">
          Browse the package list by OEM
          <Icon name="arrow-right" />
        </a>
      </p>
    </div>
  </section>

  <!-- Guides -->
  <section id="guides" class="section section-alt">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Guides</p>
        <h2 class="h2">Guides</h2>
        <p class="lead">Step-by-step guides for setting up ADB, choosing a tier and debloating by phone brand.</p>
      </div>

      <ul class="grid-auto-lg">
        {
          guides.map((guide) => (
            <li>
              <a href={guide.href} class="card h-full">
                <Icon name={guide.icon} class="size-6 text-accent" />
                <h3 class="h4 mt-4">{guide.title}</h3>
                <p class="mt-1 text-sm text-muted">{guide.text}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- How to undo -->
  <section id="undo" class="section">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Restore</p>
        <h2 class="h2">How to undo a change</h2>
        <p class="lead">
          Both actions can be reversed, because a system app stays on the read-only system image: it is only disabled or
          removed for one user.
        </p>
      </div>

      <ul class="grid gap-stack lg:grid-cols-2">
        <li class="card min-w-0">
          <h3 class="h4">Restore a snapshot with the CLI</h3>
          <p class="mt-2 text-sm text-muted">
            Snapshots are saved in <code class="code">~/AiPhoneDebloater/backups/</code>. From a clone of the repository:
          </p>
          <pre class="code-block mt-stack" tabindex="0"><code>{restoreCliLines.map((line, index) => (<Fragment>{index > 0 ? '\n' : ''}{line.comment ? <span class="c">{line.text}</span> : line.text}</Fragment>))}</code></pre>
          <p class="mt-stack text-sm text-muted">
            After a one-command install, the interactive menu has the same options: list backups, restore from a backup
            and restore a single package.
          </p>
        </li>
        <li class="card min-w-0">
          <h3 class="h4">Bring back one package over ADB</h3>
          <p class="mt-2 text-sm text-muted">No snapshot and no tool needed, only the package name:</p>
          <pre class="code-block mt-stack" tabindex="0"><code>{restoreAdbLines.map((line, index) => (<Fragment>{index > 0 ? '\n' : ''}{line.comment ? <span class="c">{line.text}</span> : line.text}</Fragment>))}</code></pre>
        </li>
        <li class="card min-w-0 lg:col-span-2">
          <h3 class="h4">Restore in the web app</h3>
          <p class="mt-2 max-w-measure text-sm text-muted">
            The web app keeps its snapshots in the browser you used. Open Snapshots and choose Restore, or use Restore on
            a single package's row. Clearing that browser's site data removes its snapshots; the ADB commands above
            still work without them.
          </p>
          <p class="mt-2">
            <a href="/app" class="link inline-flex min-h-11 items-center">Open the web app</a>
          </p>
        </li>
      </ul>

      <div class="callout callout-warn mt-stack-lg" role="note">
        <Icon name="triangle-alert" />
        <div class="max-w-measure">
          <p class="callout-title">Back up your files first</p>
          <p>
            A snapshot records which packages were installed and enabled, not your photos, chats or app data. The CLI
            flag <code class="code">--no-backup</code> skips the snapshot; leave it off.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section section-alt">
    <div class="container-page grid gap-x-stack-lg lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="h2">Frequently asked questions</h2>
        <p class="lead">
          Not answered here? Ask in the
          <a href={`${GITHUB_REPO}/issues`} class="link" target="_blank" rel="noopener noreferrer">issue tracker<span class="sr-only"> (opens in a new tab)</span></a>.
        </p>
      </div>

      <div class="min-w-0">
        {
          FAQ.map((item) => (
            <details class="disclosure" id={item.id}>
              <summary>
                <h3>{item.question}</h3>
                <Icon name="chevron-down" />
              </summary>
              <div class="disclosure-body prose">
                <p set:html={item.answerHtml} />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="section cta-band">
    <div class="container-page">
      <div class="section-head section-head-center">
        <h2 class="h2">Start with Tier 1</h2>
        <p class="lead">
          Whichever way you choose, review the plan before you confirm and keep the snapshot. AI Phone Debloater is free
          and open source under the MIT License.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/app" class="btn btn-primary btn-lg">
          <Icon name="monitor" />
          Open the web app
        </a>
        <CopyButton
          from="master-prompt"
          label="Copy the AI agent prompt"
          announce={promptAnnouncement}
          class="btn btn-secondary btn-lg"
        />
        <a href="#cli" class="btn btn-secondary btn-lg">
          <Icon name="terminal" />
          Install the CLI
        </a>
        <a href={GITHUB_REPO} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          View the source
          <Icon name="arrow-up-right" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- The master prompt, once. A JSON data block is not executed, so the CSP does not gate it;
       every "copy the prompt" button (CopyButton from="master-prompt") reads it synchronously
       inside its click handler. -->
  <script type="application/json" id="master-prompt" set:html={JSON.stringify(masterPrompt).replace(/</g, '\\u003c')} />

  <script>
    // A link to an FAQ item (/#root, /#adb-setup ...) opens that item.
    function openTargetedDetails(): void {
      let id = '';
      try {
        id = decodeURIComponent(window.location.hash.slice(1));
      } catch {
        return;
      }
      const target = id ? document.getElementById(id) : null;
      if (target instanceof HTMLDetailsElement) target.open = true;
    }

    window.addEventListener('hashchange', openTargetedDetails);
    openTargetedDetails();
  </script>
</Base>
