          <div class="flex flex-wrap items-center justify-center gap-4">
            <button
              type="button"
              class="footer-prompt-copy-btn px-7 py-3.5 rounded-xl bg-white text-emerald-800 font-bold hover:bg-emerald-50 transition-colors shadow-lg cursor-pointer"
              data-prompt={masterPrompt}
            >
              Copy AI Agent Prompt
            </button>
            <a
              href="/app"
              class="px-7 py-3.5 rounded-xl border border-white/30 bg-emerald-800/40 hover:bg-emerald-800/60 text-white font-semibold transition-colors"
            >
              Open WebApp
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <!-- Copy Buttons Logic -->
    <script>
      // CLI & Generic copy buttons
      const copyBtns = document.querySelectorAll('.copy-btn');
      copyBtns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-cmd') || '';
          try {
            await navigator.clipboard.writeText(cmd);
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<span class="text-emerald-400 font-bold">✓ Copied!</span>';
            setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
          } catch {
            prompt('Copy this command:', cmd);
          }
        });
      });

      // Master Prompt Copy Buttons (Hero + Card + Footer)
      const setupPromptCopy = (selector: string, textSelector?: string) => {
        const buttons = document.querySelectorAll(selector);
        buttons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const text = btn.getAttribute('data-prompt') || '';
            try {
              await navigator.clipboard.writeText(text);
              const labelEl = textSelector ? btn.querySelector(textSelector) : btn;
              if (labelEl) {
                const originalText = labelEl.textContent;
                labelEl.textContent = '✓ Copied Prompt!';
                setTimeout(() => {
                  labelEl.textContent = originalText;
                }, 2500);
              }
            } catch {
              prompt('Copy AI Agent Prompt:', text);
            }
          });
        });
      };

      setupPromptCopy('#copy-master-prompt-btn', '#copy-prompt-btn-text');
      setupPromptCopy('.secondary-prompt-copy-btn');
      setupPromptCopy('.footer-prompt-copy-btn');

      // Auto-open FAQ details when navigating via hash
      const openTargetFaq = () => {
        const hash = window.location.hash;
        if (!hash) return;
        const target = document.querySelector(hash);
        if (target && target.tagName === 'DETAILS') {
          (target as HTMLDetailsElement).open = true;
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 50);
        } else if (target) {
          const parentDetails = target.closest('details');
          if (parentDetails) {
            parentDetails.open = true;
            setTimeout(() => {
              parentDetails.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 50);
          }
        }
      };

      window.addEventListener('hashchange', openTargetFaq);
      // Wait for layout on initial page load if hash present
      if (window.location.hash) {
        setTimeout(openTargetFaq, 100);
      } else {
        openTargetFaq();
      }
    </script>
  </body>
</html>
