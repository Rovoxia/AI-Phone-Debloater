---
// 404 page. Also the reference for a page built on Base.astro: one <Base> with the SEO props,
// sections made of `section` + `container-page`, design-system classes, <Icon /> for icons.
// `noindex` keeps it out of the index and drops canonical, Open Graph and JSON-LD.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { GITHUB_REPO } from '../lib/seo';

const destinations: { href: string; icon: IconName; title: string; text: string }[] = [
  {
    href: '/app',
    icon: 'monitor',
    title: 'Web app',
    text: 'Remove bloatware from the browser over WebUSB or the local ADB bridge.',
  },
  {
    href: '/oems',
    icon: 'list',
    title: 'Package list by OEM',
    text: 'Every rule, with its safety tier and recommended action.',
  },
  {
    href: '/blog',
    icon: 'book-open',
    title: 'Guides',
    text: 'Debloat guides by phone brand, ADB setup and the safety tiers.',
  },
];
---

<Base
  title="Page not found"
  description="This page does not exist on AI Phone Debloater. Go to the home page, the web app, the package list by OEM or the guides."
  path="/404"
  noindex
>
  <section class="section">
    <div class="container-page">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1 mt-3">Page not found</h1>
      <p class="lead mt-stack">
        Nothing lives at this address. The link may be out of date, or the address may have a typo.
      </p>

      <div class="mt-stack-lg flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">
          <Icon name="arrow-left" />
          Back to the home page
        </a>
        <a href={`${GITHUB_REPO}/issues`} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          Report a broken link
          <Icon name="arrow-up-right" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>

      <h2 class="h3 mt-section-sm">Where to go next</h2>
      <ul class="grid-auto mt-stack">
        {
          destinations.map((item) => (
            <li>
              <a href={item.href} class="card h-full">
                <Icon name={item.icon} class="size-6 text-accent" />
                <span class="h4 mt-4 block">{item.title}</span>
                <span class="mt-1 block text-sm text-muted">{item.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
