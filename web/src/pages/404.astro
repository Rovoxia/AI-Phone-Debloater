---
// src/pages/404.astro
// Production-ready 404 page with clean vector animation, fast and minimal.
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_VERSION } from '../lib/version';

const siteVersion = SITE_VERSION;
---

<!doctype html>
<html lang="en" class="scroll-smooth" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>404 — Page Not Found | AI Phone Debloater</title>
    <meta name="description" content="The page you're looking for doesn't exist. Return to the AI Phone Debloater homepage or explore our guides." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph Fallback -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="404 — Page Not Found | AI Phone Debloater" />
    <meta property="og:description" content="The page you're looking for doesn't exist. Return to the AI Phone Debloater homepage or explore our guides." />
    <meta property="og:image" content="https://debloater.rovoxia.com/og-image.png" />
    <meta property="og:image:secure_url" content="https://debloater.rovoxia.com/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image" content="https://debloater.rovoxia.com/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://debloater.rovoxia.com/og-image.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="debloater.rovoxia.com" />
    <meta property="twitter:domain" content="debloater.rovoxia.com" />
    <meta name="twitter:url" content="https://debloater.rovoxia.com/404" />
    <meta property="twitter:url" content="https://debloater.rovoxia.com/404" />
    <meta name="twitter:title" content="404 — Page Not Found | AI Phone Debloater" />
    <meta property="twitter:title" content="404 — Page Not Found | AI Phone Debloater" />
    <meta name="twitter:description" content="The page you're looking for doesn't exist. Return to the AI Phone Debloater homepage or explore our guides." />
    <meta property="twitter:description" content="The page you're looking for doesn't exist. Return to the AI Phone Debloater homepage or explore our guides." />
    <meta name="twitter:image" content="https://debloater.rovoxia.com/og-image.png" />
    <meta name="twitter:image:src" content="https://debloater.rovoxia.com/og-image.png" />
    <meta property="twitter:image" content="https://debloater.rovoxia.com/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    </noscript>
    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-slate-50 text-slate-900 dark:bg-[#0b0f17] dark:text-slate-100 antialiased min-h-screen transition-colors duration-150">
    <Navbar />

    <main class="flex min-h-[calc(100vh-4rem)] flex-col items-center justify-center px-4 py-12">
      <!-- Vector Animation Scene -->
      <div class="relative w-full max-w-md mx-auto mb-10" aria-hidden="true">
        <svg
          class="w-full h-auto"
          viewBox="0 0 320 280"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-labelledby="not-found-title"
        >
          <title id="not-found-title">404 Page Not Found - disconnected path animation</title>

          <!-- Circuit board traces (static background) -->
          <g class="traces" stroke="#e2e8f0" stroke-width="1.5" stroke-linecap="round" opacity="0.4">
            <path d="M40 40h120M40 40v80M160 40v80M160 120h80M240 120v80" />
            <path d="M40 200h120M160 200v80M240 200h80" stroke="#94a3b8" stroke-width="1" />
            <circle cx="100" cy="100" r="4" fill="#64748b" />
            <circle cx="220" cy="180" r="3" fill="#64748b" />
            <circle cx="80" cy="220" r="3" fill="#64748b" />
            <circle cx="260" cy="60" r="2" fill="#64748b" />
          </g>

          <!-- Animated broken path - the "404" concept -->
          <g class="path-group">
            <!-- Segment 1: Start node -->
            <circle class="node node-start" cx="50" cy="140" r="10" fill="#10b981" stroke="#059669" stroke-width="2">
              <animate attributeName="r" values="10;12;10" dur="2s" repeatCount="indefinite" />
              <animate attributeName="opacity" values="1;0.6;1" dur="2s" repeatCount="indefinite" />
            </circle>

            <!-- Segment 2: Middle path with break -->
            <path class="path-segment" d="M60 140 Q120 100 180 140" stroke="#10b981" stroke-width="3" stroke-linecap="round" fill="none" stroke-dasharray="0 150" stroke-dashoffset="0">
              <animate attributeName="stroke-dasharray" values="0 150;150 0;150 0;0 150" dur="2.4s" repeatCount="indefinite" />
              <animate attributeName="stroke-dashoffset" values="0;0;-150;-150" dur="2.4s" repeatCount="indefinite" />
            </path>

            <!-- Gap indicator (the missing link) -->
            <g class="gap-indicator" transform="translate(180 140)">
              <line x1="-12" y1="0" x2="12" y2="0" stroke="#ef4444" stroke-width="2.5" stroke-dasharray="8 4" stroke-linecap="round">
                <animate attributeName="stroke-dashoffset" values="0;12" dur="0.8s" repeatCount="indefinite" />
              </line>
              <circle cx="0" cy="0" r="6" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="3 3">
                <animate attributeName="r" values="6;10;6" dur="1.2s" repeatCount="indefinite" />
                <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.2s" repeatCount="indefinite" />
              </circle>
            </g>

            <!-- Segment 3: End node (disconnected) -->
            <circle class="node node-end" cx="270" cy="140" r="10" fill="#64748b" stroke="#475569" stroke-width="2" opacity="0.5">
              <animate attributeName="opacity" values="0.5;0.8;0.5" dur="2s" repeatCount="indefinite" />
            </circle>

            <!-- Floating packet particles -->
            <g class="particles" fill="#10b981" opacity="0.8">
              <circle cx="80" cy="120" r="3">
                <animateMotion path="M80 120 Q130 90 175 135" dur="1.8s" repeatCount="indefinite" rotate="auto" />
              </circle>
              <circle cx="95" cy="105" r="2">
                <animateMotion path="M95 105 Q135 85 178 130" dur="2.2s" repeatCount="indefinite" rotate="auto" begin="0.4s" />
              </circle>
              <circle cx="110" cy="125" r="2.5">
                <animateMotion path="M110 125 Q145 105 176 140" dur="2s" repeatCount="indefinite" rotate="auto" begin="0.8s" />
              </circle>
            </g>

            <!-- Error code display -->
            <text x="160" y="245" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="14" font-weight="500" fill="#64748b" class="error-code">
              <tspan class="digit" dy="0">4</tspan>
              <tspan class="digit" dy="0">0</tspan>
              <tspan class="digit" dy="0">4</tspan>
              <animate attributeName="opacity" values="1;0.4;1" dur="1.5s" repeatCount="indefinite" />
            </text>
          </g>
        </svg>

        <!-- CSS-based scanline overlay for extra depth -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
          <div class="scanline" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Content -->
      <div class="text-center space-y-5">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          <span class="text-emerald-600 dark:text-emerald-400">404</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-md mx-auto leading-relaxed">
          The path you requested doesn't exist in our rule database. Like a removed bloatware package, it's been cleanly uninstalled.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border-t border-white/30 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm shadow-md shadow-emerald-600/25 hover:shadow-lg hover:shadow-emerald-600/35 transition-all duration-150 hover:-translate-y-0.5 active:translate-y-0"
          >
            <svg class="w-4.5 h-4.5 text-emerald-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6" />
            </svg>
            <span>Return Home</span>
          </a>
          <a
            href="/oems"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border border-slate-300/80 dark:border-slate-700/80 bg-white dark:bg-slate-800/80 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-sm transition-colors shadow-xs"
          >
            <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" />
              <line x1="12" y1="18" x2="12.01" y2="18" />
            </svg>
            <span>Supported OEMs</span>
          </a>
        </div>

        <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">
          AI Phone Debloater v{siteVersion} · <a href="https://github.com/Rovoxia/AI-Phone-Debloater" target="_blank" rel="noopener noreferrer" class="underline hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">GitHub</a>
        </p>
      </div>
    </main>

    <Footer />

    <style>
      /* Scanline effect */
      .scanline {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(16, 185, 129, 0.02) 2px,
          rgba(16, 185, 129, 0.02) 4px
        );
        animation: scanline-move 3s linear infinite;
        pointer-events: none;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 60%, transparent 100%);
      }

      @keyframes scanline-move {
        0% { transform: translateY(-100%); }
        100% { transform: translateY(100%); }
      }

      /* Respect reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .scanline,
        .node [animate],
        .path-segment [animate],
        .gap-indicator [animate],
        .particles [animateMotion],
        .error-code [animate] {
          animation: none !important;
        }
      }
    </style>
  </body>
</html>