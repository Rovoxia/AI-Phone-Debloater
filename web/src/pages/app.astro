---
// src/pages/app.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const SITE_URL = 'https://debloater.rovoxia.com';
const CANONICAL_URL = `${SITE_URL}/app`;
const TITLE = 'WebApp Workspace — AI-Phone-Debloater';
const DESCRIPTION = 'Visual ADB package manager and rootless debloater workspace. Audit Android packages, simulate tier removals, and manage devices directly in browser.';
const KEYWORDS = 'Android web debloater, WebADB debloat, visual ADB package manager, rootless Android optimization workspace';
---

<!doctype html>
<html lang="en" class="scroll-smooth" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Rovoxia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={CANONICAL_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:site_name" content="AI Phone Debloater" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Phone-Debloater WebApp Workspace Preview" />
    <meta property="og:image" content={`${SITE_URL}/og-image.jpg`} />
    <meta property="og:image:secure_url" content={`${SITE_URL}/og-image.jpg`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI-Phone-Debloater WebApp Workspace Preview" />

    <!-- Twitter Card (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="debloater.rovoxia.com" />
    <meta property="twitter:domain" content="debloater.rovoxia.com" />
    <meta name="twitter:url" content={CANONICAL_URL} />
    <meta property="twitter:url" content={CANONICAL_URL} />
    <meta name="twitter:title" content={TITLE} />
    <meta property="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta property="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:src" content={`${SITE_URL}/og-image.png`} />
    <meta property="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:alt" content="AI-Phone-Debloater WebApp Workspace Preview" />
    <meta property="twitter:image:alt" content="AI-Phone-Debloater WebApp Workspace Preview" />

    <!-- Google Fonts (Optimized) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    </noscript>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://debloater.rovoxia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "WebApp Workspace",
              "item": "https://debloater.rovoxia.com/app"
            }
          ]
        },
        {
          "@type": "WebApplication",
          "name": "AI Phone Debloater WebApp Workspace",
          "operatingSystem": "All modern browsers (Chrome, Edge, Firefox, Brave)",
          "applicationCategory": "UtilitiesApplication, DeveloperApplication",
          "url": "https://debloater.rovoxia.com/app",
          "description": "Browser-based Android ADB package auditor and debloater workspace with 4-tier safety enforcement.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "author": {
            "@type": "Organization",
            "name": "Rovoxia",
            "url": "https://rovoxia.com"
          }
        }
      ]
    })} />
    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#f8f9fa] text-[#202124] dark:bg-[#121212] dark:text-[#e8eaed] antialiased min-h-screen transition-colors duration-150">

    <Navbar />

    <main class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
      <section class="flex min-h-[70vh] flex-col items-center justify-center text-center">
        <div class="mb-8 w-full max-w-md sm:max-w-lg" aria-hidden="true">
          <svg class="build-scene mx-auto h-auto w-full" viewBox="0 0 420 280" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
            <title>A workspace being assembled</title>

            {/* Ground line */}
            <line class="ground" x1="48" y1="248" x2="372" y2="248" />

            {/* Scaffold uprights and cross braces */}
            <g class="scaffold">
              <line x1="92" y1="248" x2="92" y2="36" />
              <line x1="328" y1="248" x2="328" y2="36" />
              <line x1="92" y1="92" x2="328" y2="92" />
              <line x1="92" y1="168" x2="328" y2="168" />
              <line x1="92" y1="168" x2="210" y2="92" />
              <line x1="210" y1="168" x2="328" y2="92" />
            </g>

            {/* Crane boom swinging a UI block into place */}
            <g class="crane">
              <line x1="328" y1="36" x2="368" y2="36" />
              <line class="cable" x1="358" y1="36" x2="358" y2="78" />
              <rect class="hook-block" x="340" y="78" width="36" height="22" rx="4" />
            </g>

            {/* Phone frame that the workspace is built inside */}
            <g class="phone">
              <rect x="128" y="48" width="164" height="200" rx="18" />
              <rect x="188" y="58" width="44" height="6" rx="3" />
            </g>

            {/* UI pieces sliding into the screen */}
            <g class="ui">
              <rect class="piece piece-sidebar" x="140" y="76" width="36" height="156" rx="6" />
              <rect class="piece piece-header" x="184" y="76" width="96" height="22" rx="5" />
              <rect class="piece piece-card-a" x="184" y="108" width="44" height="52" rx="5" />
              <rect class="piece piece-card-b" x="236" y="108" width="44" height="52" rx="5" />
              <rect class="piece piece-row-a" x="184" y="170" width="96" height="14" rx="4" />
              <rect class="piece piece-row-b" x="184" y="192" width="72" height="14" rx="4" />
              <rect class="piece piece-row-c" x="184" y="214" width="84" height="10" rx="4" />
            </g>

            {/* Spark that lands once the last piece is in */}
            <circle class="spark" cx="280" cy="87" r="3" />
          </svg>
        </div>

        <span class="inline-flex items-center rounded-full border border-violet-500/30 bg-violet-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">
          Upcoming
        </span>

        <h1 class="mt-5 text-2xl font-normal tracking-tight text-slate-900 dark:text-white sm:text-3xl">
          WebApp Workspace — Coming Soon
        </h1>

        <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-500 dark:text-slate-400">
          We're building something powerful. The visual WebApp workspace is under active construction and will be available soon.
        </p>

        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
          <a
            href="/#cli"
            class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-emerald-700"
          >
            <span>&larr; Use the CLI instead</span>
          </a>
          <a
            href="https://github.com/Rovoxia/AI-Phone-Debloater"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 dark:border-slate-800 dark:bg-[#181c24] dark:text-slate-300 dark:hover:bg-slate-800"
          >
            Watch on GitHub
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .build-scene {
    overflow: visible;
  }

  .ground {
    stroke: #94a3b8;
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.7;
  }

  :global(.dark) .ground {
    stroke: #475569;
  }

  .scaffold line {
    stroke: #a78bfa;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: draw 8s ease-in-out infinite;
  }

  :global(.dark) .scaffold line {
    stroke: #8b5cf6;
  }

  .crane line {
    stroke: #10b981;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .crane {
    transform-box: fill-box;
    transform-origin: 0% 0%;
    animation: swing 8s ease-in-out infinite;
  }

  .cable {
    stroke-dasharray: 42;
    stroke-dashoffset: 42;
    animation: drop 8s ease-in-out infinite;
  }

  .hook-block {
    fill: #10b981;
    opacity: 0;
    animation: carry 8s ease-in-out infinite;
  }

  .phone rect:first-child {
    stroke: #64748b;
    stroke-width: 2.5;
    stroke-dasharray: 760;
    stroke-dashoffset: 760;
    animation: draw 8s ease-in-out infinite;
  }

  :global(.dark) .phone rect:first-child {
    stroke: #94a3b8;
  }

  .phone rect:last-child {
    fill: #94a3b8;
    opacity: 0;
    animation: fade-late 8s ease-in-out infinite;
  }

  .piece {
    opacity: 0;
  }

  .piece-sidebar {
    fill: #10b981;
    animation: slide-left 8s ease-in-out infinite;
  }

  .piece-header {
    fill: #8b5cf6;
    animation: slide-down 8s ease-in-out infinite;
  }

  .piece-card-a,
  .piece-card-b {
    fill: #34d399;
    opacity: 0.85;
  }

  .piece-card-a {
    animation: slide-up 8s ease-in-out infinite;
  }

  .piece-card-b {
    animation: slide-up 8s ease-in-out infinite;
    animation-delay: 0.18s;
  }

  .piece-row-a,
  .piece-row-b,
  .piece-row-c {
    fill: #c4b5fd;
  }

  :global(.dark) .piece-row-a,
  :global(.dark) .piece-row-b,
  :global(.dark) .piece-row-c {
    fill: #6d28d9;
  }

  .piece-row-a {
    animation: slide-right 8s ease-in-out infinite;
  }

  .piece-row-b {
    animation: slide-right 8s ease-in-out infinite;
    animation-delay: 0.15s;
  }

  .piece-row-c {
    animation: slide-right 8s ease-in-out infinite;
    animation-delay: 0.3s;
  }

  .spark {
    fill: #10b981;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: spark 8s ease-in-out infinite;
  }

  @keyframes draw {
    0% { stroke-dashoffset: 260; }
    22%, 78% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 260; }
  }

  .phone rect:first-child {
    animation-name: draw-frame;
  }

  @keyframes draw-frame {
    0% { stroke-dashoffset: 760; }
    28%, 78% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 760; }
  }

  @keyframes swing {
    0%, 18% { transform: rotate(-8deg); }
    42%, 70% { transform: rotate(0deg); }
    100% { transform: rotate(-8deg); }
  }

  @keyframes drop {
    0%, 16% { stroke-dashoffset: 42; }
    30%, 62% { stroke-dashoffset: 0; }
    78%, 100% { stroke-dashoffset: 42; }
  }

  @keyframes carry {
    0%, 20% { opacity: 0; transform: translateY(-14px); }
    34%, 58% { opacity: 1; transform: translateY(0); }
    72%, 100% { opacity: 0; transform: translateY(-14px); }
  }

  @keyframes slide-left {
    0%, 30% { opacity: 0; transform: translateX(-18px); }
    46%, 76% { opacity: 1; transform: translateX(0); }
    92%, 100% { opacity: 0; transform: translateX(-18px); }
  }

  @keyframes slide-down {
    0%, 36% { opacity: 0; transform: translateY(-16px); }
    52%, 76% { opacity: 1; transform: translateY(0); }
    92%, 100% { opacity: 0; transform: translateY(-16px); }
  }

  @keyframes slide-up {
    0%, 42% { opacity: 0; transform: translateY(16px); }
    58%, 76% { opacity: 0.9; transform: translateY(0); }
    92%, 100% { opacity: 0; transform: translateY(16px); }
  }

  @keyframes slide-right {
    0%, 48% { opacity: 0; transform: translateX(18px); }
    64%, 76% { opacity: 1; transform: translateX(0); }
    92%, 100% { opacity: 0; transform: translateX(18px); }
  }

  @keyframes fade-late {
    0%, 24% { opacity: 0; }
    36%, 78% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes spark {
    0%, 66% { opacity: 0; transform: scale(0.4); }
    72% { opacity: 1; transform: scale(1.4); }
    80%, 100% { opacity: 0; transform: scale(0.4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .build-scene * {
      animation: none !important;
      stroke-dashoffset: 0 !important;
      opacity: 1 !important;
      transform: none !important;
    }

    .hook-block,
    .spark,
    .cable {
      opacity: 0 !important;
    }
  }
</style>
