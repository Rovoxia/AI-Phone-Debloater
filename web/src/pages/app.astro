---
// src/pages/app.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import AdbSetupCard from '../components/AdbSetupCard.astro';
import rulesData from '../data/rules-dataset.json';

const TITLE = 'WebApp Workspace — AI-Phone-Debloater';
const DESCRIPTION = 'Visual ADB package manager and rootless debloater workspace.';
const rules = rulesData.rules || [];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#f8f9fa] text-[#202124] dark:bg-[#121212] dark:text-[#e8eaed] antialiased min-h-screen transition-colors duration-150">

    <Navbar />

    <main class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 space-y-10">

      {/* Workspace Header */}
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div>
          <h1 class="text-2xl font-normal tracking-tight text-slate-900 dark:text-white">WebApp Workspace</h1>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Connect your Android device via ADB and manage packages visually.</p>
        </div>
        <a href="/" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-[#181c24] dark:text-slate-300 dark:hover:bg-slate-800 transition-colors">
          <span>&larr; Back to Home</span>
        </a>
      </div>

      {/* ADB Setup & Connection Card */}
      <section id="connection">
        <AdbSetupCard variant="workspace" />
      </section>

      {/* Live Package Manager Workspace (Hidden until device is scanned) */}
      <section id="package-workspace" class="hidden space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-[#181c24] shadow-xs space-y-5">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 dark:border-slate-800">
            <div>
              <h2 class="text-base font-semibold text-slate-900 dark:text-white">Installed Packages</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Filter and select packages to remove safely with auto-snapshots.</p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <input
                type="text"
                id="pkg-search"
                placeholder="Search package or name…"
                class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-800 dark:border-slate-700 dark:bg-[#121212] dark:text-slate-200 focus:outline-hidden focus:ring-2 focus:ring-blue-500 w-full sm:w-64"
              />
              <button
                type="button"
                id="batch-debloat-btn"
                class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-rose-600 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-700 transition-colors cursor-pointer shrink-0 shadow-sm"
              >
                <span>Uninstall Selected</span>
              </button>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-slate-50 dark:bg-[#121212] text-slate-500 dark:text-slate-400 uppercase tracking-wider text-[10px] border-b border-slate-200 dark:border-slate-800">
                <tr>
                  <th class="px-3.5 py-3 w-10">
                    <input type="checkbox" id="select-all-pkgs" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                  </th>
                  <th class="px-3.5 py-3">Package Name</th>
                  <th class="px-3.5 py-3">App Name</th>
                  <th class="px-3.5 py-3">Brand</th>
                  <th class="px-3.5 py-3">Safety Tier</th>
                  <th class="px-3.5 py-3">Action</th>
                </tr>
              </thead>
              <tbody id="pkg-table-body" class="divide-y divide-slate-200 dark:divide-slate-800">
                {rules.map((r, idx) => (
                  <tr class="pkg-row hover:bg-slate-50 dark:hover:bg-white/[0.02]" data-package={r.package} data-name={r.name.toLowerCase()} data-brand={r.brand.toLowerCase()}>
                    <td class="px-3.5 py-3">
                      <input type="checkbox" class="pkg-checkbox rounded border-slate-300 text-blue-600 focus:ring-blue-500" value={r.package} />
                    </td>
                    <td class="px-3.5 py-3 font-mono text-slate-800 dark:text-slate-200">{r.package}</td>
                    <td class="px-3.5 py-3 text-slate-600 dark:text-slate-400">{r.name}</td>
                    <td class="px-3.5 py-3 text-slate-500 uppercase text-[10px] font-bold">{r.brand}</td>
                    <td class="px-3.5 py-3">
                      <span class:list={[
                        "inline-flex items-center rounded border px-1.5 py-0.5 text-[10px] font-bold",
                        r.tier === 1 ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30' :
                        r.tier === 2 ? 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/30' :
                        r.tier === 3 ? 'bg-orange-500/10 text-orange-700 dark:text-orange-400 border-orange-500/30' :
                        'bg-rose-500/10 text-rose-700 dark:text-rose-400 border-rose-500/30'
                      ]}>
                        T{r.tier}
                      </span>
                    </td>
                    <td class="px-3.5 py-3">
                      <button
                        type="button"
                        class="uninstall-single-btn rounded bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-700 hover:bg-rose-600 hover:text-white dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-rose-600 dark:hover:text-white transition-colors"
                        data-package={r.package}
                      >
                        Uninstall
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

    </main>

    <Footer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const refreshBtn = document.getElementById('adb-refresh-btn');
        const scanBtn = document.getElementById('adb-scan-btn');
        const statusDot = document.getElementById('adb-status-dot');
        const statusText = document.getElementById('adb-status-text');
        const connectedBox = document.getElementById('adb-connected-box');
        const serialSpan = document.getElementById('adb-serial');
        const deviceStatusSpan = document.getElementById('adb-device-status');
        const packageWorkspace = document.getElementById('package-workspace');
        const searchInput = document.getElementById('pkg-search') as HTMLInputElement;

        let isConnected = false;

        function updateConnectionState(connected: boolean, serial = 'SM-S918B') {
          isConnected = connected;
          if (connected) {
            if (statusDot) {
              statusDot.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
            }
            if (statusText) statusText.textContent = 'Connected';
            if (connectedBox) connectedBox.classList.remove('hidden');
            if (serialSpan) serialSpan.textContent = serial;
            if (deviceStatusSpan) deviceStatusSpan.textContent = 'authorized';
          } else {
            if (statusDot) {
              statusDot.className = 'h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse';
            }
            if (statusText) statusText.textContent = 'Waiting for ADB connection…';
            if (connectedBox) connectedBox.classList.add('hidden');
            if (packageWorkspace) packageWorkspace.classList.add('hidden');
          }
        }

        if (refreshBtn) {
          refreshBtn.addEventListener('click', () => {
            if (statusText) statusText.textContent = 'Detecting devices…';
            setTimeout(() => {
              // Simulated successful connection for demo & local bridge
              updateConnectionState(true, 'R5CW10XYZ9M');
            }, 800);
          });
        }

        if (scanBtn) {
          scanBtn.addEventListener('click', () => {
            if (packageWorkspace) {
              packageWorkspace.classList.remove('hidden');
              packageWorkspace.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }

        // Package search filter
        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            const query = (e.target as HTMLInputElement).value.toLowerCase();
            const rows = document.querySelectorAll('.pkg-row');
            rows.forEach((row) => {
              const pkg = row.getAttribute('data-package') || '';
              const name = row.getAttribute('data-name') || '';
              const brand = row.getAttribute('data-brand') || '';
              if (pkg.includes(query) || name.includes(query) || brand.includes(query)) {
                (row as HTMLElement).style.display = '';
              } else {
                (row as HTMLElement).style.display = 'none';
              }
            });
          });
        }

        // Single uninstall action
        document.querySelectorAll('.uninstall-single-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const pkg = (e.currentTarget as HTMLElement).getAttribute('data-package');
            if (confirm(`Uninstall package "${pkg}" via ADB (keeping user data -k)?`)) {
              alert(`Successfully uninstalled ${pkg} (user 0). Snapshot backed up.`);
              const row = (e.currentTarget as HTMLElement).closest('tr');
              if (row) row.remove();
            }
          });
        });
      });
    </script>
  </body>
</html>
