---
// /blog: the guide index. The list comes from the `blog` content collection through
// src/lib/blog.ts, the same source as /blog/<slug>, /rss.xml and the sitemap dates.
// To add a guide, add a Markdown file to src/content/blog/. Nothing here needs editing.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { RULE_STATS } from '../data/tiers';
import { abs, blogNode, formatDate, itemListNode, type Crumb } from '../lib/seo';
import {
  CATEGORY_INFO,
  FEED_PATH,
  getPosts,
  postPath,
  postWordCount,
  readingMinutes,
  ymd,
} from '../lib/blog';

const TITLE = 'Android Debloat Guides by Phone Brand';
const DESCRIPTION =
  'Step-by-step Android debloat guides for Samsung, Xiaomi, Pixel, OnePlus, Oppo, Vivo, Motorola and Tecno/Infinix, plus ADB setup and safety tiers.';

const posts = await getPosts();

const groups = CATEGORY_INFO.map((category) => ({
  ...category,
  posts: posts.filter((post) => post.data.category === category.name),
})).filter((group) => group.posts.length > 0);

// The order on the page, which the Blog and ItemList nodes repeat.
const ordered = groups.flatMap((group) => group.posts);

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/blog' },
];
---

<Base
  title={TITLE}
  description={DESCRIPTION}
  path="/blog"
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  jsonLd={[
    blogNode(DESCRIPTION, ordered.map(postPath)),
    itemListNode(
      `${abs('/blog')}#posts`,
      'Android debloat guides',
      ordered.map((post) => ({ name: post.data.title, path: postPath(post) })),
    ),
  ]}
>
  <section class="section">
    <div class="container-page">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-stack-lg">Guides</p>
      <h1 class="h1 mt-3 text-balance">Android debloat guides by phone brand</h1>
      <p class="lead mt-stack">
        These guides show how to turn off preinstalled apps on an Android phone over ADB, without root, using AI Phone
        Debloater. Pick your brand to see which packages the rule set covers and in which safety tier, what you may
        notice afterwards, and how to undo it. Every count and package table in them is generated from the
        {RULE_STATS.total} rules the tool itself uses.
      </p>

      <nav class="mt-stack-lg" aria-label="Guide categories">
        <ul class="flex flex-wrap gap-2">
          {
            groups.map((group) => (
              <li>
                <a class="chip" href={`#${group.id}`}>
                  {group.name}
                  <span class="font-mono text-xs">{group.posts.length}</span>
                  <span class="sr-only">{group.posts.length === 1 ? 'guide' : 'guides'}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <div class="section section-alt">
    <div class="container-page">
      {
        groups.map((group) => (
          <section class="guide-group" id={group.id} aria-labelledby={`${group.id}-title`}>
            <div class="section-head">
              <h2 class="h2" id={`${group.id}-title`}>
                {group.name}
              </h2>
              <p class="lead">{group.description}</p>
            </div>
            <ul class="grid-auto">
              {group.posts.map((post) => {
                const published = ymd(post.data.pubDate);
                const updated = ymd(post.data.updatedDate);
                return (
                  <li class="card card-hover guide-card">
                    <h3 class="h3">
                      <a class="guide-card-link" href={postPath(post)}>
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="mt-3 text-sm text-muted">{post.data.description}</p>
                    <ul class="guide-card-meta meta">
                      <li>
                        Published <time datetime={published}>{formatDate(published)}</time>
                      </li>
                      {updated !== published && (
                        <li>
                          Updated <time datetime={updated}>{formatDate(updated)}</time>
                        </li>
                      )}
                      <li>{readingMinutes(postWordCount(post))} min read</li>
                    </ul>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <section class="section" aria-labelledby="more-title">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Beyond the guides</p>
        <h2 class="h2" id="more-title">Look up a package or follow new guides</h2>
        <p class="lead">
          The package list shows every rule with its brand, tier and action. The feed carries each guide when it is
          published.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/oems">Browse the package list</a>
        <a class="btn btn-secondary" href="/app">Open the web app</a>
        <a class="btn btn-ghost" href={FEED_PATH}>
          <Icon name="rss" />
          RSS feed
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .guide-group + .guide-group {
    margin-top: var(--spacing-section-sm);
  }

  /* Cards in a row share a height; the dates sit on the bottom edge. */
  .guide-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .guide-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  /* The title is the link, and it covers the whole card. */
  .guide-card-link {
    transition: color 150ms ease;
  }

  .guide-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-box);
  }

  .guide-card-link:hover {
    color: var(--color-accent);
  }
</style>
