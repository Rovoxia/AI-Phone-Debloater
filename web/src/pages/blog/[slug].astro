---
// A blog post. The text comes from src/content/blog/<slug>.md (schema: src/content.config.ts).
// Everything that states a tier, a count or a package is built here from rules-dataset.json and
// src/data/tiers.ts, never typed in the Markdown, so it cannot drift from the rule set:
//   - `oemIds` in the frontmatter: the tier counts above the body and the full rule tables below it
//   - `tierOverview: true`: the four-tier table above the body and the per-brand and Tier 4 tables below it
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import TierBadge from '../../components/TierBadge.astro';
import rulesData from '../../data/rules-dataset.json';
import { REMOVABLE_TIERS, RULE_STATS, TIERS, TIER_BY_ID, type Tier } from '../../data/tiers';
import { ORG_NAME, ORG_URL, SITE_NAME, blogPostingNode, formatDate, type Crumb } from '../../lib/seo';
import {
  getPosts,
  postHeadTitle,
  postPath,
  postWordCount,
  readingMinutes,
  relatedPosts,
  ymd,
  type Post,
} from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);

const path = postPath(post);
const published = ymd(data.pubDate);
const updated = ymd(data.updatedDate);
const wordCount = postWordCount(post);
const minutes = readingMinutes(wordCount);
const head = postHeadTitle(post, SITE_NAME);
const related = relatedPosts(post, posts);

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/blog' },
  { name: data.title, path },
];

/* ---- Rule data for this post ------------------------------------------- */

type Rule = (typeof rulesData.rules)[number];

const byName = (a: Rule, b: Rule) => a.name.localeCompare(b.name, 'en');
const plural = (count: number, word: string) => `${count} ${count === 1 ? word : `${word}s`}`;
const tierCount = (rules: Rule[], tier: Tier) => rules.filter((rule) => rule.tier === tier.id).length;

interface RuleGroup {
  oemId: string;
  /** The dataset's own name for the group, e.g. "BBK (Oppo, Vivo, Realme)". */
  label: string;
  /** Rules listed in this post. */
  rules: Rule[];
  /** Every rule in the group's rule file. */
  fileTotal: number;
  /** Rules left out by `excludePackagePrefixes`. */
  hidden: number;
  tiers: { tier: Tier; rules: Rule[] }[];
}

const excludedPrefixes = data.excludePackagePrefixes ?? [];

function ruleGroup(oemId: string, prefixes: string[] = []): RuleGroup {
  const all = rulesData.rules.filter((rule) => rule.oemId === oemId);
  if (all.length === 0) {
    throw new Error(`${post.id}: oemIds names "${oemId}", but rules-dataset.json has no rule with that oemId.`);
  }
  const rules = all.filter((rule) => !prefixes.some((prefix) => rule.package.startsWith(prefix)));
  return {
    oemId,
    label: all[0].oemGroup,
    rules,
    fileTotal: all.length,
    hidden: all.length - rules.length,
    tiers: REMOVABLE_TIERS.map((tier) => ({
      tier,
      rules: rules.filter((rule) => rule.tier === tier.id).sort(byName),
    })).filter((entry) => entry.rules.length > 0),
  };
}

const groups: RuleGroup[] = (data.oemIds ?? []).map((oemId) => ruleGroup(oemId, excludedPrefixes));
const hasRules = groups.length > 0;
// The CLI loads the universal file on every phone, so the counts show it next to the brand's file.
const universal = groups.some((group) => group.oemId === 'universal') ? null : ruleGroup('universal');
const summaryRows = universal ? [...groups, universal] : groups;
const hiddenTotal = groups.reduce((sum, group) => sum + group.hidden, 0);

/* ---- Tier overview (the safety-tiers post) ------------------------------ */

const overview = data.tierOverview;

const brandIds = [...new Set(rulesData.rules.filter((rule) => rule.tier !== 4).map((rule) => rule.oemId))];
const brandRows = overview
  ? brandIds.map((oemId) => ruleGroup(oemId)).sort((a, b) => a.label.localeCompare(b.label, 'en'))
  : [];

const criticalRules = rulesData.rules.filter((rule) => rule.tier === 4);
const criticalCategories = overview
  ? [...new Set(criticalRules.map((rule) => rule.category))]
      .map((category) => {
        const rules = criticalRules.filter((rule) => rule.category === category).sort(byName);
        return { category, label: category.replace(/_/g, ' '), rules };
      })
      .sort((a, b) => b.rules.length - a.rules.length || a.label.localeCompare(b.label, 'en'))
  : [];

/* ---- "On this page" ----------------------------------------------------- */

const hasSummary = hasRules || overview;
const hasAppendix = hasRules || overview;
const summaryTitle = overview ? 'The four tiers at a glance' : 'How many rules apply';
const appendixTitle = overview ? 'Rules by brand and the protected list' : 'Full rule list by tier';

const toc = [
  ...(hasSummary ? [{ id: 'summary', text: summaryTitle }] : []),
  ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, text: heading.text })),
  ...(hasAppendix ? [{ id: 'rules', text: appendixTitle }] : []),
];

const actionLabel = (action: string) => (action === 'uninstall' ? 'Uninstall' : 'Disable');
---

<Base
  title={head.title}
  titleTemplate={head.withSiteName ? undefined : false}
  description={data.description}
  path={path}
  ogType="article"
  article={{ publishedTime: published, modifiedTime: updated, section: data.category, tags: data.tags }}
  breadcrumbs={crumbs}
  jsonLd={[
    blogPostingNode({
      path,
      headline: data.title,
      description: data.description,
      datePublished: published,
      dateModified: updated,
      section: data.category,
      tags: data.tags,
      wordCount,
    }),
  ]}
>
  <article>
    <div class="section">
      <div class="container-page">
        <header>
          <Breadcrumbs items={crumbs} />
          <p class="eyebrow mt-stack-lg">{data.category}</p>
          <h1 class="h1 mt-3 text-balance">{data.title}</h1>
          <p class="lead mt-stack">{data.answer}</p>
          <ul class="post-meta mt-stack">
            <li>
              <span>
                By
                <a class="link" href={ORG_URL} target="_blank" rel="noopener noreferrer">{ORG_NAME}<span class="sr-only"> (opens in a new tab)</span></a>
              </span>
            </li>
            <li>
              <Icon name="calendar" />
              <span>Published <time datetime={published}>{formatDate(published)}</time></span>
            </li>
            <li>
              <Icon name="refresh-cw" />
              <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>
            </li>
            <li>
              <Icon name="clock" />
              <span>{minutes} min read</span>
            </li>
          </ul>
        </header>

        <div class="post-layout mt-stack-lg">
          <nav class="post-toc" aria-labelledby="toc-title">
            <h2 id="toc-title" class="eyebrow">On this page</h2>
            <ol class="mt-2">
              {
                toc.map((entry) => (
                  <li>
                    <a href={`#${entry.id}`}>{entry.text}</a>
                  </li>
                ))
              }
            </ol>
          </nav>

          <div class="post-main">
            {
              hasRules && (
                <section id="summary" aria-labelledby="summary-title" class="post-summary">
                  <h2 id="summary-title" class="h3">{summaryTitle}</h2>
                  <p class="mt-2 text-sm text-muted">
                    The CLI loads the rule file that matches the phone's manufacturer, plus the universal file of
                    carrier and partner apps found on many brands. A rule does something only if its package is
                    installed on your phone.
                  </p>
                  <div class="table-wrap mt-stack" role="region" aria-labelledby="summary-title" tabindex="0">
                    <table class="table table-compact">
                      <thead>
                        <tr>
                          <th scope="col">Rule file</th>
                          {
                            REMOVABLE_TIERS.map((tier) => (
                              <th scope="col" class="num">
                                {tier.label}<span class="sr-only">: {tier.name}</span>
                              </th>
                            ))
                          }
                          <th scope="col" class="num">Rules</th>
                        </tr>
                      </thead>
                      <tbody>
                        {
                          summaryRows.map((group) => (
                            <tr>
                              <th scope="row">
                                <a class="link" href={`/oems/${group.oemId}`}>{group.label}</a>
                                {group.hidden > 0 && (
                                  <span class="font-normal text-muted">
                                    {` (${group.rules.length} of ${group.fileTotal} listed here)`}
                                  </span>
                                )}
                              </th>
                              {REMOVABLE_TIERS.map((tier) => (
                                <td class="num">{tierCount(group.rules, tier)}</td>
                              ))}
                              <td class="num">{group.rules.length}</td>
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                  </div>
                  <ul class="post-legend mt-3">
                    {
                      REMOVABLE_TIERS.map((tier) => (
                        <li>
                          <TierBadge tier={tier.id} />
                        </li>
                      ))
                    }
                  </ul>
                  <p class="meta mt-3">
                    Counts are read from the rule set when this page is built.
                    {
                      hiddenTotal > 0 &&
                        ` A shared rule file also holds ${plural(hiddenTotal, 'rule')} for other brands' packages; ${hiddenTotal === 1 ? 'it is' : 'they are'} not counted here.`
                    }
                    {` ${TIER_BY_ID[4].label} (${TIER_BY_ID[4].name}) protects ${RULE_STATS.critical} packages on every phone; no tier includes them. `}
                    <a class="link" href="#rules">See every rule</a>.
                  </p>
                </section>
              )
            }

            {
              overview && (
                <section id="summary" aria-labelledby="summary-title" class="post-summary">
                  <h2 id="summary-title" class="h3">{summaryTitle}</h2>
                  <div class="table-wrap mt-stack" role="region" aria-labelledby="summary-title" tabindex="0">
                    <table class="table table-compact">
                      <thead>
                        <tr>
                          <th scope="col">Tier</th>
                          <th scope="col" class="num">Rules</th>
                          <th scope="col">Who it is for</th>
                          <th scope="col">What it covers</th>
                        </tr>
                      </thead>
                      <tbody>
                        {
                          TIERS.map((tier) => (
                            <tr>
                              <th scope="row">
                                <TierBadge tier={tier.id} />
                              </th>
                              <td class="num">{tier.count}</td>
                              <td>{tier.audience}</td>
                              <td class="post-cell-text">{tier.description}</td>
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                  </div>
                  <p class="meta mt-3">
                    {`${RULE_STATS.total} rules in all: ${RULE_STATS.removable} that a plan can act on and ${RULE_STATS.critical} protected packages. Counts are read from the rule set when this page is built.`}
                  </p>
                </section>
              )
            }

            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      hasRules && (
        <section id="rules" class="section section-alt" aria-labelledby="rules-title">
          <div class="container-page">
            <div class="section-head">
              <p class="eyebrow">Rule set</p>
              <h2 id="rules-title" class="h2">
                {appendixTitle}
              </h2>
              <p class="lead">
                These tables are generated from the same rule files the CLI and the web app use, so they match what the
                tool does. "Suggested action" is the rule file's note. The CLI disables by default and uninstalls only
                when you pass <code class="code">--action uninstall</code>.
              </p>
            </div>

            {
              groups.map((group) => (
                <div class="post-group">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="h3" id={`rules-${group.oemId}`}>
                      {group.label}: {plural(group.rules.length, 'rule')}
                    </h3>
                    <a class="link text-sm" href={`/oems/${group.oemId}`}>
                      {group.label} package list
                    </a>
                  </div>
                  {group.hidden > 0 && (
                    <p class="mt-2 text-sm text-muted">
                      {`The ${group.label} rule file has ${plural(group.fileTotal, 'rule')}. ${plural(group.hidden, 'rule')} for packages of the other brands in the file (names starting with `}
                      {excludedPrefixes.map((prefix, index) => (
                        <>{index > 0 && ', '}<span class="pkg">{prefix}</span></>
                      ))}{`) ${group.hidden === 1 ? 'is' : 'are'} left out of this guide. The CLI still loads the whole file; a rule for an app that is not installed does nothing.`}
                    </p>
                  )}
                  {group.tiers.map(({ tier, rules }) => (
                    <div class="mt-stack">
                      <h4 class="flex flex-wrap items-center gap-x-3 gap-y-1" id={`rules-${group.oemId}-tier-${tier.id}`}>
                        <TierBadge tier={tier.id} />
                        <span class="text-sm font-normal text-muted">
                          {plural(rules.length, 'rule')}. {tier.audience}
                        </span>
                      </h4>
                      <div
                        class="table-wrap mt-3"
                        role="region"
                        aria-labelledby={`rules-${group.oemId}-tier-${tier.id}`}
                        tabindex="0"
                      >
                        <table class="table table-compact">
                          <thead>
                            <tr>
                              <th scope="col">Package</th>
                              <th scope="col">App</th>
                              <th scope="col">What the rule file says</th>
                              <th scope="col">Suggested action</th>
                            </tr>
                          </thead>
                          <tbody>
                            {rules.map((rule) => (
                              <tr>
                                <th scope="row" class="post-cell-pkg">
                                  <span class="pkg">{rule.package}</span>
                                </th>
                                <td class="post-cell-name">{rule.name}</td>
                                <td class="post-cell-text">{rule.description}</td>
                                <td>{actionLabel(rule.recommended_action)}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  ))}
                </div>
              ))
            }

            <ul class="grid-auto post-group">
              {
                universal && (
                  <li class="card">
                    <p class="h4">{universal.label}</p>
                    <p class="mt-1 text-sm text-muted">
                      {`${plural(universal.rules.length, 'rule')} for carrier and partner apps that ship on many brands. The CLI loads them on every phone.`}
                    </p>
                    <a class="link mt-3 inline-flex min-h-11 items-center text-sm" href="/oems/universal">
                      Universal package list
                    </a>
                  </li>
                )
              }
              <li class="card">
                <p class="h4">{TIER_BY_ID[4].title}</p>
                <p class="mt-1 text-sm text-muted">
                  {`${RULE_STATS.critical} protected packages. The tool refuses to disable or uninstall them, whatever tier or flag is used.`}
                </p>
                <a class="link mt-3 inline-flex min-h-11 items-center text-sm" href="/oems/critical">
                  Protected package list
                </a>
              </li>
            </ul>
          </div>
        </section>
      )
    }

    {
      overview && (
        <section id="rules" class="section section-alt" aria-labelledby="rules-title">
          <div class="container-page">
            <div class="section-head">
              <p class="eyebrow">Rule set</p>
              <h2 id="rules-title" class="h2">
                {appendixTitle}
              </h2>
              <p class="lead">
                Generated from the same rule files the CLI and the web app use. Follow a brand to see each of its
                packages with its tier.
              </p>
            </div>

            <h3 class="h3" id="rules-by-brand">
              Rules per brand and tier
            </h3>
            <div class="table-wrap mt-stack" role="region" aria-labelledby="rules-by-brand" tabindex="0">
              <table class="table table-compact">
                <thead>
                  <tr>
                    <th scope="col">Rule file</th>
                    {REMOVABLE_TIERS.map((tier) => (
                      <th scope="col" class="num">
                        {tier.label}<span class="sr-only">: {tier.name}</span>
                      </th>
                    ))}
                    <th scope="col" class="num">
                      Rules
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {brandRows.map((group) => (
                    <tr>
                      <th scope="row">
                        <a class="link" href={`/oems/${group.oemId}`}>{group.label}</a>
                      </th>
                      {REMOVABLE_TIERS.map((tier) => (
                        <td class="num">{tierCount(group.rules, tier)}</td>
                      ))}
                      <td class="num">{group.rules.length}</td>
                    </tr>
                  ))}
                  <tr>
                    <th scope="row">All removal rules</th>
                    {REMOVABLE_TIERS.map((tier) => (
                      <td class="num font-semibold text-ink">{tier.count}</td>
                    ))}
                    <td class="num font-semibold text-ink">{RULE_STATS.removable}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="post-group">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="h3" id="rules-critical">
                  {`${TIER_BY_ID[4].title}: ${RULE_STATS.critical} protected packages`}
                </h3>
                <a class="link text-sm" href="/oems/critical">
                  Protected package list
                </a>
              </div>
              <p class="mt-2 text-sm text-muted">
                Grouped by the category each entry has in the critical rule file. The names are the rule file's own.
              </p>
              <div class="table-wrap mt-stack" role="region" aria-labelledby="rules-critical" tabindex="0">
                <table class="table table-compact">
                  <thead>
                    <tr>
                      <th scope="col">Category</th>
                      <th scope="col" class="num">
                        Packages
                      </th>
                      <th scope="col">Protected components</th>
                    </tr>
                  </thead>
                  <tbody>
                    {criticalCategories.map((entry) => (
                      <tr>
                        <th scope="row" class="post-cell-name">
                          {entry.label}
                        </th>
                        <td class="num">{entry.rules.length}</td>
                        <td class="post-cell-text">{entry.rules.map((rule) => rule.name).join(', ')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      )
    }
  </article>

  <section class="section" aria-labelledby="related-title">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Keep reading</p>
        <h2 id="related-title" class="h2">Related guides</h2>
      </div>
      <ul class="grid-auto">
        {
          related.map((other) => (
            <li class="card card-hover relative">
              <p class="meta">{other.data.category}</p>
              <h3 class="h4 mt-2">
                <a class="post-card-link" href={postPath(other)}>
                  {other.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-muted">{other.data.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-stack-lg">
        <a class="link inline-flex min-h-11 items-center gap-2" href="/blog">
          <Icon name="arrow-left" />
          All guides
        </a>
      </p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="cta-title">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Next step</p>
        <h2 id="cta-title" class="h2">Check your own phone</h2>
        <p class="lead">
          The web app lists the packages on your phone with their tiers and asks before every change. The command-line
          tool does the same from a terminal and adds a dry run. Both are free and open source, and neither needs root.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/app">
          Open the web app
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn-secondary" href="/oems">
          <Icon name="list" />
          Browse the package list
        </a>
        <a class="btn btn-ghost" href="/#cli">
          <Icon name="terminal" />
          Get the command-line tool
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Byline, dates and reading time under the title. */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    color: var(--color-faint);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  .post-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* One column on small screens (contents, then the text); the contents move to a sticky
     right-hand column once there is room for it beside a 70ch measure. */
  .post-layout {
    display: grid;
    gap: var(--spacing-stack-lg);
  }

  .post-main {
    min-width: 0;
  }

  .post-toc {
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-box);
    background-color: var(--color-subtle);
  }

  .post-toc ol {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  .post-toc a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: 0.375rem;
    color: var(--color-muted);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  .post-toc a:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
      align-items: start;
    }

    .post-main {
      grid-column: 1;
      grid-row: 1;
    }

    .post-toc {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--spacing-header) + 1.5rem);
      max-height: calc(100dvh - var(--spacing-header) - 3rem);
      overflow-y: auto;
    }

    .post-toc a {
      min-height: 0;
    }
  }

  @media (min-width: 64rem) and (pointer: coarse) {
    .post-toc a {
      min-height: 2.75rem;
    }
  }

  /* The counts above the text share its measure. */
  .post-summary {
    max-width: var(--container-measure);
    margin-bottom: var(--spacing-stack-lg);
  }

  .post-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Blocks in the generated rule list. */
  .post-group {
    margin-top: var(--spacing-section-sm);
  }

  .section-head + .post-group {
    margin-top: 0;
  }

  /* Column widths that keep the rule tables readable: text columns get a floor so they do not
     collapse to one word per line, and the table scrolls inside .table-wrap when they do not fit. */
  .post-cell-pkg {
    min-width: 18rem;
    font-weight: 500;
  }

  .post-cell-name {
    min-width: 9rem;
  }

  .post-cell-text {
    min-width: 16rem;
  }

  /* The title link covers its card. */
  .post-card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-box);
  }

  .post-card-link {
    transition: color 150ms ease;
  }

  .post-card-link:hover {
    color: var(--color-accent);
  }
</style>
