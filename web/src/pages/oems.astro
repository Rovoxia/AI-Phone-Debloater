---
// src/pages/oems.astro
// Complete OEM rule directory and search browser for AI-Phone-Debloater
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import rulesData from '../data/rules-dataset.json';

const SITE_URL = 'https://debloater.rovoxia.com';
const CANONICAL_URL = `${SITE_URL}/oems`;
const TITLE = 'Supported Android OEMs & Bloatware Rules | AI Phone Debloater';
const DESCRIPTION = 'Explore 352 verified debloat rules across Xiaomi HyperOS, Samsung One UI, OnePlus, Oppo, Vivo, Google Pixel, Motorola, and Transsion. 100% rootless and reversible.';
const KEYWORDS = 'OEM debloat rules, Xiaomi HyperOS debloat, Samsung One UI bloatware list, ColorOS debloat, FuntouchOS, Pixel telemetry, ADB debloat rules';

const oemProfiles = [
  {
    id: 'xiaomi',
    name: 'Xiaomi, Redmi & Poco',
    skin: 'HyperOS / MIUI',
    badge: 'HyperOS',
    tagline: 'Strip aggressive ad daemons (MSA), telemetry collectors, and preinstalled recommendation engines.',
    anchor: 'xiaomi-miui-hyperos',
    ruleCount: rulesData.stats.oemBreakdown['Xiaomi'] || 28,
    color: 'emerald',
    features: ['MSA Ad Daemons', 'Mi Video / Mi Music', 'Mi Browser', 'Joyose Analytics', 'Xiaomi Cloud Sync']
  },
  {
    id: 'samsung',
    name: 'Samsung Galaxy',
    skin: 'One UI',
    badge: 'One UI',
    tagline: 'Remove Bixby voice triggers, Samsung Pay bloatware, Galaxy Store trackers, and duplicate apps without tripping Knox (0x0).',
    anchor: 'samsung-oneui',
    ruleCount: rulesData.stats.oemBreakdown['Samsung'] || 45,
    color: 'blue',
    features: ['Bixby Agent & Routines', 'Samsung Pass / Pay', 'Game Optimizing Service (GOS)', 'AR Emoji & Stickers', 'Knox 0x0 Safe']
  },
  {
    id: 'bbk',
    name: 'OnePlus, Oppo & Realme',
    skin: 'ColorOS & OxygenOS',
    badge: 'ColorOS',
    tagline: 'Disable HeyTap services, aggressive App Market notifications, background analytics, and carrier bloatware.',
    anchor: 'coloros-oxygenos',
    ruleCount: 13,
    color: 'amber',
    features: ['HeyTap Market & Cloud', 'Oppo Roaming', 'OnePlus Membership', 'Theme Store Push Ads', 'Quick Device Connect']
  },
  {
    id: 'vivo',
    name: 'Vivo & iQOO',
    skin: 'FuntouchOS & OriginOS',
    badge: 'Funtouch',
    tagline: 'Clean Jovi voice assistant, V-Appstore auto-installers, lockscreen poster services, and background telemetry.',
    anchor: 'vivo-funtouch',
    ruleCount: 10,
    color: 'indigo',
    features: ['Jovi Assistant', 'V-Appstore & Game Center', 'iManager Background Tasks', 'Vivo Cloud Services', 'Lockscreen Glance']
  },
  {
    id: 'pixel',
    name: 'Google Pixel & Nothing OS',
    skin: 'Pixel UI / Stock AOSP',
    badge: 'Pixel / AOSP',
    tagline: 'Clean carrier telemetry, unused Google ecosystem apps, Digital Wellbeing trackers, and setup daemons.',
    anchor: 'google-pixel',
    ruleCount: rulesData.stats.oemBreakdown['Google'] || 25,
    color: 'teal',
    features: ['Carrier Services', 'Digital Wellbeing', 'Google Feedback & Partner Setup', 'Pixel Ambient Services', 'Google Duo / Meet']
  },
  {
    id: 'motorola',
    name: 'Motorola',
    skin: 'My UX / Hello UI',
    badge: 'Moto',
    tagline: 'Eliminate Moto notifications, carrier partner daemons, preinstalled games, and background analytics.',
    anchor: 'motorola',
    ruleCount: rulesData.stats.oemBreakdown['Motorola'] || 15,
    color: 'sky',
    features: ['Moto Suggestions', 'Ready For Daemons', 'Carrier Hub', 'Moto Face Unlock Logs', 'Mobile Services Manager']
  },
  {
    id: 'transsion',
    name: 'Tecno, Infinix & Itel',
    skin: 'HiOS / XOS / itel OS',
    badge: 'Transsion',
    tagline: 'Purge aggressive Palm Store ads, Phoenix browser, Aha Games recommendations, and system push notification services.',
    anchor: 'transsion',
    ruleCount: rulesData.stats.oemBreakdown['Transsion'] || 29,
    color: 'orange',
    features: ['Palm Store & Game Center', 'Phoenix Browser Engine', 'Carlcare Background Sync', 'Scooper News Push', 'XShare Ad Service']
  },
  {
    id: 'universal',
    name: 'Universal Android & Carrier',
    skin: 'AOSP / All OEMs',
    badge: 'Universal',
    tagline: 'Carrier bloatware (Facebook App Manager, Netflix partner daemons, MobileIron, DT Ignite) common to all Android devices.',
    anchor: 'universal',
    ruleCount: rulesData.stats.oemBreakdown['Universal'] || 81,
    color: 'violet',
    features: ['Facebook App Installer & Manager', 'Netflix Partner Activation', 'Carrier Hub / DT Ignite', 'Amazon Assistant Bloat', 'Android Diagnostics']
  },
  {
    id: 'critical',
    name: 'Core System Protection',
    skin: 'Hard-Blocked Invariant',
    badge: 'Tier 4',
    tagline: '89 essential Android operating system packages permanently hard-blocked against removal to guarantee 100% bootloop prevention.',
    anchor: 'critical',
    ruleCount: rulesData.stats.tier4CriticalCount || 89,
    color: 'rose',
    features: ['Android System Framework', 'System UI & Navigation', 'Settings Provider', 'Telephony & Emergency Services', 'Keymaster & Biometrics']
  }
];

// All rules serialized for fast client-side searching & filtering
const allRules = rulesData.rules;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="keywords" content={KEYWORDS} />
    <meta name="author" content="Rovoxia" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={CANONICAL_URL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CANONICAL_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:site_name" content="AI Phone Debloater" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:secure_url" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Phone Debloater Supported OEMs & 352 Bloatware Rules Matrix" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:alt" content="AI Phone Debloater Supported OEMs & 352 Bloatware Rules Matrix" />

    <!-- Google Fonts (Optimized) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>

    <!-- JSON-LD Structured Data (Dataset & Breadcrumb) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://debloater.rovoxia.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Supported OEMs & Rules",
              "item": "https://debloater.rovoxia.com/oems"
            }
          ]
        },
        {
          "@type": "Dataset",
          "name": "AI Phone Debloater Curated OEM Rules Database",
          "description": "352 classified package rules across Xiaomi, Samsung, OnePlus, Oppo, Vivo, Google Pixel, Motorola, and Transsion Android devices with safety tiers and rootless ADB actions.",
          "url": "https://debloater.rovoxia.com/oems",
          "keywords": ["Android debloat", "bloatware removal", "ADB packages", "Samsung One UI", "Xiaomi HyperOS", "Google Pixel debloat", "OnePlus debloat", "rootless debloat"],
          "license": "https://opensource.org/licenses/MIT",
          "creator": {
            "@type": "Organization",
            "name": "Rovoxia",
            "url": "https://rovoxia.com"
          }
        }
      ]
    })} />
    <script is:inline>
      (function() {
        try {
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const stored = localStorage.getItem('theme');
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-[#f8f9fa] text-[#202124] dark:bg-[#090d14] dark:text-[#e8eaed] antialiased min-h-screen transition-colors duration-150">
    <Navbar />

    <main class="py-12 md:py-16">
      <!-- Breadcrumb + Hero Title -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-4 font-mono">
          <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
          <span>/</span>
          <span class="text-slate-800 dark:text-slate-200">Supported OEMs</span>
        </nav>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-slate-200 dark:border-slate-800">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Rootless ADB Compatibility Matrix</span>
            </div>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
              Supported OEMs &amp; Debloat Rules
            </h1>
            <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
              Curated databases across all major Android manufacturers. Every rule categorizes package purpose, safety tier, and recommended action.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <div class="text-right hidden sm:block">
              <div class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">352</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Total Classified Packages</div>
            </div>
            <a
              href="/#cli"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors shadow-sm shadow-emerald-600/20"
            >
              <span>Run Automated CLI</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- OEM Grid Cards -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-6 flex items-center justify-between">
          <span>OEM Rulebases &amp; Coverage</span>
          <span class="text-xs font-normal text-slate-500 dark:text-slate-400 font-mono">Click card to jump to rules</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {oemProfiles.map((oem) => (
            <a
              href={`#${oem.anchor}`}
              class="group relative rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-[#10141e] p-5 shadow-xs hover:shadow-md hover:border-emerald-500/50 dark:hover:border-emerald-500/40 transition-all duration-200 flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                    {oem.badge}
                  </span>
                  <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">
                    {oem.ruleCount} rules
                  </span>
                </div>

                <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                  {oem.name}
                </h3>
                <div class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-2.5">
                  {oem.skin}
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-4">
                  {oem.tagline}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80">
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {oem.features.slice(0, 3).map((f) => (
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-800">
                      {f}
                    </span>
                  ))}
                </div>
                <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  Browse rules &rarr;
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Interactive Rules Explorer (Search + Filter) -->
      <section id="rules-explorer" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#10141e] p-6 shadow-sm">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
            <div>
              <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white flex items-center gap-2">
                <span>Interactive Rules Explorer</span>
                <span class="text-xs font-mono font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Live Search</span>
              </h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Filter by OEM, search by package name, or filter by safety tier.
              </p>
            </div>

            <!-- Search input -->
            <div class="relative w-full md:w-80">
              <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="11" cy="11" r="8" stroke-width="2" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2" stroke-linecap="round" />
              </svg>
              <input
                id="search-input"
                type="text"
                placeholder="Search package (e.g. msa, bixby, heytap)..."
                class="w-full pl-9 pr-4 py-2 rounded-xl text-xs bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500"
              />
            </div>
          </div>

          <!-- Filter Pills -->
          <div class="flex flex-wrap items-center gap-2 mb-6 text-xs" id="filter-container">
            <span class="text-slate-400 text-xs font-medium mr-1">Brand:</span>
            <button type="button" class="oem-filter active px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-medium transition-colors cursor-pointer" data-brand="all">
              All ({allRules.length})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Xiaomi">
              Xiaomi ({rulesData.stats.oemBreakdown['Xiaomi'] || 28})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Samsung">
              Samsung ({rulesData.stats.oemBreakdown['Samsung'] || 45})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="BBK">
              Oppo / Realme (13)
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="OnePlus">
              OnePlus ({rulesData.stats.oemBreakdown['OnePlus'] || 20})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Vivo">
              Vivo / iQOO (10)
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Google">
              Google Pixel ({rulesData.stats.oemBreakdown['Google'] || 25})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Motorola">
              Motorola ({rulesData.stats.oemBreakdown['Motorola'] || 15})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Transsion">
              Tecno / Infinix ({rulesData.stats.oemBreakdown['Transsion'] || 29})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" data-brand="Universal">
              Universal ({rulesData.stats.oemBreakdown['Universal'] || 81})
            </button>
            <button type="button" class="oem-filter px-2.5 py-1 rounded-lg border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 text-rose-700 dark:text-rose-400 hover:border-rose-300 transition-colors cursor-pointer" data-brand="Core System">
              Critical (89)
            </button>
          </div>

          <!-- Table Container -->
          <div class="border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
            <div class="overflow-x-auto max-h-[640px] overflow-y-auto">
              <table class="w-full text-left text-xs" id="rules-table">
                <thead class="sticky top-0 bg-slate-50 dark:bg-slate-900/90 backdrop-blur-xs border-b border-slate-200 dark:border-slate-800 text-slate-500 font-semibold z-10">
                  <tr>
                    <th class="py-2.5 px-3 sm:px-4">Tier</th>
                    <th class="py-2.5 px-3 sm:px-4">Package</th>
                    <th class="py-2.5 px-3 sm:px-4 hidden sm:table-cell">Name &amp; Category</th>
                    <th class="py-2.5 px-3 sm:px-4 hidden md:table-cell">Brand</th>
                    <th class="py-2.5 px-3 sm:px-4">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 font-mono" id="rules-body">
                  {allRules.map((rule) => {
                    const isCrit = rule.tier === 4 || rule.brand === 'Core System';
                    const tierLabel = isCrit ? 'Tier 4' : `Tier ${rule.tier}`;
                    const tierClass = isCrit
                      ? 'bg-rose-100 text-rose-800 dark:bg-rose-500/20 dark:text-rose-300'
                      : rule.tier === 1
                      ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300'
                      : rule.tier === 2
                      ? 'bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300'
                      : 'bg-orange-100 text-orange-800 dark:bg-orange-500/20 dark:text-orange-300';
                    const actionLabel = isCrit ? '⛔ Hard-Blocked' : rule.recommended_action === 'uninstall' ? 'Uninstall' : 'Disable';
                    const actionClass = isCrit ? 'text-rose-600 dark:text-rose-400 font-bold' : 'text-slate-700 dark:text-slate-300';
                    const isVivoPkg = rule.brand === 'BBK' && (rule.package.toLowerCase().includes('vivo') || (rule.name || '').toLowerCase().includes('vivo'));
                    const displayBrand = isVivoPkg ? 'Vivo' : rule.brand === 'BBK' ? 'Oppo/Realme' : rule.brand;

                    return (
                      <tr
                        class="rule-row hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition-colors"
                        data-package={rule.package.toLowerCase()}
                        data-name={(rule.name || '').toLowerCase()}
                        data-brand={rule.brand}
                        data-tier={rule.tier}
                      >
                        <td class="py-2.5 px-3 sm:px-4 whitespace-nowrap">
                          <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${tierClass}`}>
                            {tierLabel}
                          </span>
                        </td>
                        <td class="py-2.5 px-3 sm:px-4 font-mono font-medium text-slate-800 dark:text-slate-200 text-[11px] sm:text-xs">
                          <div class="truncate max-w-[200px] sm:max-w-[280px]" title={rule.package}>
                            {rule.package}
                          </div>
                          <div class="sm:hidden font-sans text-[11px] text-slate-500 dark:text-slate-400 truncate mt-0.5">
                            {rule.name}
                          </div>
                        </td>
                        <td class="py-2.5 px-3 sm:px-4 font-sans text-slate-600 dark:text-slate-400 hidden sm:table-cell">
                          <div class="font-medium text-slate-800 dark:text-slate-200 truncate max-w-[220px]">
                            {rule.name || rule.package}
                          </div>
                          <div class="text-[10px] text-slate-400 font-mono">
                            {rule.category || 'bloatware'}
                          </div>
                        </td>
                        <td class="py-2.5 px-3 sm:px-4 font-sans text-slate-500 dark:text-slate-400 hidden md:table-cell whitespace-nowrap">
                          <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                            {displayBrand}
                          </span>
                        </td>
                        <td class="py-2.5 px-3 sm:px-4 whitespace-nowrap">
                          <span class={`text-[11px] font-medium font-mono ${actionClass}`}>
                            {actionLabel}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-mono">
            <span id="results-count">Showing {allRules.length} packages</span>
            <a href="/#cli" class="text-emerald-600 dark:text-emerald-400 hover:underline">
              Debloat via CLI &rarr;
            </a>
          </div>
        </div>
      </section>

      <!-- Anchor Targets for direct navigation from existing links -->
      <div id="hyperos-debloat" class="scroll-mt-24"></div>
      <div id="hyperos-miui" class="scroll-mt-24"></div>
      <div id="xiaomi-miui-hyperos" class="scroll-mt-24"></div>
      <div id="samsung-oneui" class="scroll-mt-24"></div>
      <div id="coloros-oxygenos" class="scroll-mt-24"></div>
      <div id="vivo-funtouch" class="scroll-mt-24"></div>
      <div id="vivo-pixel-stock" class="scroll-mt-24"></div>
      <div id="pixel-nothing" class="scroll-mt-24"></div>
      <div id="google-pixel" class="scroll-mt-24"></div>
      <div id="motorola" class="scroll-mt-24"></div>
      <div id="transsion" class="scroll-mt-24"></div>
      <div id="universal" class="scroll-mt-24"></div>
      <div id="critical" class="scroll-mt-24"></div>
      <div id="analyzer" class="scroll-mt-24"></div>
      <div id="rules" class="scroll-mt-24"></div>

    </main>

    <Footer />

    <!-- Client-side filter & search script -->
    <script is:inline>
      (function() {
        const searchInput = document.getElementById('search-input');
        const filterBtns = document.querySelectorAll('.oem-filter');
        const rows = document.querySelectorAll('.rule-row');
        const countDisplay = document.getElementById('results-count');

        let currentBrand = 'all';
        let currentQuery = '';

        // Read URL hash on load (e.g. /oems#samsung-oneui or /oems?brand=Samsung)
        function checkInitialHash() {
          const hash = window.location.hash.replace('#', '');
          const hashToBrand = {
            'hyperos-debloat': 'Xiaomi',
            'hyperos-miui': 'Xiaomi',
            'xiaomi-miui-hyperos': 'Xiaomi',
            'xiaomi': 'Xiaomi',
            'samsung-oneui': 'Samsung',
            'samsung': 'Samsung',
            'coloros-oxygenos': 'BBK',
            'oneplus': 'OnePlus',
            'oppo': 'BBK',
            'realme': 'BBK',
            'vivo-funtouch': 'Vivo',
            'vivo': 'Vivo',
            'iqoo': 'Vivo',
            'pixel-nothing': 'Google',
            'google-pixel': 'Google',
            'google': 'Google',
            'pixel': 'Google',
            'motorola': 'Motorola',
            'moto': 'Motorola',
            'transsion': 'Transsion',
            'tecno': 'Transsion',
            'infinix': 'Transsion',
            'universal': 'Universal',
            'critical': 'Core System'
          };
          if (hash && hashToBrand[hash]) {
            setBrandFilter(hashToBrand[hash]);
            // Scroll to explorer
            const explorer = document.getElementById('rules-explorer');
            if (explorer) {
              setTimeout(() => explorer.scrollIntoView({ behavior: 'smooth' }), 100);
            }
          }
        }

        function setBrandFilter(brand) {
          currentBrand = brand;
          filterBtns.forEach(btn => {
            const btnBrand = btn.getAttribute('data-brand');
            if (btnBrand === brand) {
              btn.className = 'oem-filter active px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-medium transition-colors cursor-pointer';
            } else {
              btn.className = 'oem-filter px-2.5 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 text-slate-600 dark:text-slate-300 hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer';
            }
          });
          applyFilters();
        }

        function applyFilters() {
          let visible = 0;
          const query = currentQuery.trim().toLowerCase();

          rows.forEach(row => {
            const pkg = row.getAttribute('data-package') || '';
            const name = row.getAttribute('data-name') || '';
            const brand = row.getAttribute('data-brand') || '';

            const isVivoPkg = brand === 'BBK' && (pkg.includes('vivo') || name.includes('vivo'));
            const matchBrand = (currentBrand === 'all')
              || (currentBrand === 'Vivo' && isVivoPkg)
              || (currentBrand === 'BBK' && brand === 'BBK' && !isVivoPkg)
              || (brand === currentBrand);
            const matchQuery = !query || pkg.includes(query) || name.includes(query);

            if (matchBrand && matchQuery) {
              row.style.display = '';
              visible++;
            } else {
              row.style.display = 'none';
            }
          });

          if (countDisplay) {
            countDisplay.textContent = `Showing ${visible} packages`;
          }
        }

        if (searchInput) {
          searchInput.addEventListener('input', (e) => {
            currentQuery = e.target.value;
            applyFilters();
          });
        }

        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const brand = btn.getAttribute('data-brand');
            setBrandFilter(brand);
          });
        });

        // Hash change event support
        window.addEventListener('hashchange', checkInitialHash);
        checkInitialHash();
      })();
    </script>
  </body>
</html>
