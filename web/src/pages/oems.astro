---
// /oems: the index of every rule in the rule set.
//
// Brand cards, counts, the table rows, the filter options and the JSON-LD are all computed from
// src/data/rules-dataset.json (through src/data/brands.ts and src/data/tiers.ts). No count, brand
// or package name is typed here.
//
// The rule table is the shared stacked table (.table-stack in src/styles/global.css) and its tier
// badges reference one icon sprite (<TierSprite />), so a row carries no styling of its own.
//
// The table is complete in the HTML and readable without JavaScript. The script at the end only
// hides rows, keeps the filter state in the URL (?q=&brand=&tier=) and maps the old /oems#<brand>
// anchors to the brand filter. Without JavaScript those anchors land on the brand's card.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import TierBadge from '../components/TierBadge.astro';
import TierSprite from '../components/TierSprite.astro';
import { TIERS, RULE_STATS, tierFor } from '../data/tiers';
import {
  BRANDS,
  BRAND_BY_ID,
  ALL_RULES,
  ANCHOR_TO_BRAND,
  actionLabel,
  exampleNames,
  joinList,
  plural,
} from '../data/brands';
import { SITE_VERSION } from '../lib/version';
import { GITHUB_REPO, SITE_NAME, abs, datasetNode, itemListNode, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Package list by OEM', path: '/oems' },
];

const total = ALL_RULES.length;
const sourceFiles = [...new Set(ALL_RULES.map((rule) => rule.sourceFile))];
const brandNames = BRANDS.flatMap((brand) => brand.metaNames);
const tiersGuide = BRANDS[0].allGuides[BRANDS[0].allGuides.length - 1];

const title = 'Android Bloatware Package List by OEM';
const description = `Searchable list of ${total} Android package rules for ${joinList(brandNames)}, with safety tier and action.`;

const brandListName = (brand: (typeof BRANDS)[number]) =>
  brand.critical ? brand.listName : `${brand.listName} bloatware list`;

const dataset = {
  ...datasetNode({
    name: `${SITE_NAME} package rules`,
    description:
      `${total} Android package rules in ${sourceFiles.length} JSON rule files. Each rule has the package name, ` +
      `the app name, a category, a description, a safety tier and a recommended action. ` +
      `${RULE_STATS.removable} rules are in Tiers 1 to 3 and ${RULE_STATS.critical} are protected Tier 4 packages.`,
    version: SITE_VERSION,
    files: sourceFiles,
    keywords: ['Android bloatware', 'Android package names', 'ADB debloat', ...brandNames],
  }),
  hasPart: BRANDS.map((brand) => ({ '@id': `${abs(brand.path)}#dataset` })),
};

const brandList = itemListNode(
  `${abs('/oems')}#brands`,
  'Bloatware lists by brand',
  BRANDS.map((brand) => ({ name: brandListName(brand), path: brand.path })),
);

const stats = [
  { value: total, label: 'package rules' },
  { value: RULE_STATS.removable, label: 'in Tiers 1 to 3, which a plan can act on' },
  { value: RULE_STATS.critical, label: 'in Tier 4, which is never changed' },
  { value: sourceFiles.length, label: 'rule files' },
];
---

<Base
  title={title}
  description={description}
  path="/oems"
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  jsonLd={[dataset, brandList]}
>
  <section class="section">
    <div class="container-page">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow mt-stack-lg">Rule set</p>
      <h1 class="h1 mt-3">Android bloatware package list by OEM</h1>
      <p class="lead mt-stack">
        The {SITE_NAME} rule set lists {total} Android packages, each with what it does, a safety tier and a
        recommended action. Tier 1 is classed as safe on any phone, Tier 2 covers features you may use, Tier 3 is for
        experts and Tier 4 is never changed. The <a class="link" href="/app">web app</a> and the
        <a class="link" href="/#cli">CLI</a> apply these rules.
      </p>

      <div class="mt-stack-lg flex flex-wrap gap-3">
        <a href="#rules-explorer" class="btn btn-primary">
          <Icon name="search" />
          Search the list
        </a>
        <a href="/app" class="btn btn-secondary">
          Open the web app
          <Icon name="arrow-right" />
        </a>
      </div>

      <dl class="grid-auto-sm mt-stack-lg">
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse justify-end">
              <dt class="stat-label">{stat.label}</dt>
              <dd class="stat-value">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">By brand</p>
        <h2 class="h2">Bloatware lists by brand</h2>
        <p class="lead">
          Each group has its own page, with every rule grouped by tier. The counts below add up to the {total} rules
          in the set.
        </p>
      </div>

      <ul class="grid-auto">
        {
          BRANDS.map((brand) => (
            <li id={brand.anchor} class="card card-hover oem-card">
              <h3 class="h3">
                <a class="oem-card-link" href={brand.path}>
                  {brand.name}
                </a>
              </h3>
              <p class="mt-1 text-sm text-muted">{brand.summary}</p>
              <p class="mt-4 flex items-baseline gap-2">
                <span class="stat-value">{brand.count}</span>
                <span class="text-sm text-muted">{brand.count === 1 ? 'rule' : 'rules'}</span>
              </p>
              <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                {brand.tiers.map((entry) => (
                  <li class="inline-flex items-center gap-1.5 font-mono text-sm text-ink">
                    <TierBadge tier={entry.tier.id} compact />
                    {entry.count}
                    <span class="sr-only">{entry.count === 1 ? 'rule' : 'rules'}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm text-muted">Includes {joinList(exampleNames(brand))}.</p>
              <p class="oem-card-foot">
                <span class="inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent" aria-hidden="true">
                  View the list
                  <Icon name="arrow-right" class="size-4" />
                </span>
                {brand.guides.map((guide) => (
                  <a class="link oem-card-guide inline-flex min-h-11 items-center text-sm" href={guide.path}>
                    {guide.title}
                  </a>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="rules-explorer">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">All rules</p>
        <h2 class="h2">Search all {total} package rules</h2>
        <p class="lead">
          Search for a package or an app, or filter by brand and tier. A filtered view has its own address, so it can
          be bookmarked or linked.
        </p>
      </div>

      <form
        id="rule-filters"
        class="rules-filters"
        role="search"
        aria-label="Package rules"
        action="/oems"
        method="get"
        autocomplete="off"
        data-anchors={JSON.stringify(ANCHOR_TO_BRAND)}
      >
        <div class="field rules-filter-q">
          <label class="label" for="rule-q">Search packages</label>
          <input id="rule-q" name="q" class="input" type="search" spellcheck="false" autocapitalize="off" />
        </div>
        <div class="field">
          <label class="label" for="rule-brand">Brand</label>
          <select id="rule-brand" name="brand" class="input">
            <option value="">All brands ({total})</option>
            {BRANDS.map((brand) => <option value={brand.id}>{`${brand.name} (${brand.count})`}</option>)}
          </select>
        </div>
        <div class="field">
          <label class="label" for="rule-tier">Tier</label>
          <select id="rule-tier" name="tier" class="input">
            <option value="">All tiers ({total})</option>
            {TIERS.map((tier) => <option value={tier.id}>{`${tier.label}: ${tier.name} (${tier.count})`}</option>)}
          </select>
        </div>
        <button type="button" class="btn btn-secondary rules-filter-reset" id="rule-reset">
          <Icon name="rotate-ccw" />
          Reset
        </button>
      </form>

      <noscript>
        <p class="text-sm text-muted">
          Search and filters need JavaScript. The complete list is below, and each brand above has its own page.
        </p>
      </noscript>

      <p id="rule-status" class="rules-status mt-stack text-sm text-muted" role="status" aria-live="polite">
        Showing all {total} rules.
      </p>

      <div id="rule-empty" class="callout mt-stack" hidden>
        <Icon name="info" />
        <div>
          <p class="callout-title">No rule matches these filters</p>
          <p>
            A package with no rule is left alone by the tiers.
            <button type="button" class="link" id="rule-empty-reset">Reset the filters</button>
          </p>
        </div>
      </div>

      <TierSprite />

      <div class="table-wrap mt-stack" id="rules">
        <table class="table table-compact table-stack" id="rules-table">
          <caption class="sr-only">
            All {total} package rules, by brand and then by tier
          </caption>
          <thead>
            <tr>
              <th scope="col" class="min-[75rem]:w-[28%]">Package</th>
              <th scope="col" class="min-[75rem]:w-[15%]">App</th>
              <th scope="col" class="min-[75rem]:w-[10%]">Brand</th>
              <th scope="col" class="min-[75rem]:w-[6.25rem]">Tier</th>
              <th scope="col" class="min-[75rem]:w-[6.5rem]">Action</th>
              <th scope="col">What it does</th>
            </tr>
          </thead>
          <tbody>
            {
              ALL_RULES.map((rule) => (
                <tr data-b={rule.oemId} data-t={tierFor(rule.tier).id}>
                  <th scope="row">{rule.package}</th>
                  <td>{rule.name}</td>
                  <td>{BRAND_BY_ID[rule.oemId].shortName}</td>
                  <td><TierBadge tier={rule.tier} compact sprite /></td>
                  <td data-label="Action">{actionLabel(rule)}</td>
                  <td>{rule.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Safety</p>
        <h2 class="h2">What the four tiers mean</h2>
        <p class="lead">
          Every rule has one tier. The tier says how much thought a package needs before it is disabled or uninstalled.
        </p>
      </div>

      <ul class="grid-auto">
        {
          TIERS.map((tier) => (
            <li class="card">
              <TierBadge tier={tier.id} />
              <p class="stat-value mt-4">{tier.count}</p>
              <p class="stat-label">{tier.count === 1 ? 'rule' : 'rules'}</p>
              <h3 class="h4 mt-4">{tier.audience}</h3>
              <p class="mt-2 text-sm text-muted">{tier.description}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-stack-lg">
        <a class="link inline-flex min-h-11 items-center gap-1.5" href={tiersGuide.path}>
          {tiersGuide.title}
          <Icon name="arrow-right" class="size-4" />
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="section-head">
        <p class="eyebrow">Use it</p>
        <h2 class="h2">How the list is used</h2>
        <p class="lead">
          Both tools read the same {plural(sourceFiles.length, 'rule file')}, save a snapshot before every change and
          refuse the {RULE_STATS.critical} critical packages.
        </p>
      </div>

      <ul class="grid-auto">
        <li>
          <a href="/app" class="card h-full">
            <Icon name="monitor" class="size-6 text-accent" />
            <span class="h4 mt-4 block">Web app</span>
            <span class="mt-1 block text-sm text-muted">
              Connect a phone over WebUSB or the local ADB bridge. The app looks up every installed package in this
              list.
            </span>
          </a>
        </li>
        <li>
          <a href="/#cli" class="card h-full">
            <Icon name="terminal" class="size-6 text-accent" />
            <span class="h4 mt-4 block">Command line</span>
            <span class="mt-1 block text-sm text-muted">
              Scan a phone, preview one tier with a dry run, then apply it. The rule file of the phone's brand is
              loaded for you.
            </span>
          </a>
        </li>
        <li>
          <a
            href={`${GITHUB_REPO}/tree/main/cli/rules`}
            class="card h-full"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="github" class="size-6 text-accent" />
            <span class="h4 mt-4 flex items-center gap-1.5">
              Rule files on GitHub
              <Icon name="arrow-up-right" class="size-4" />
              <span class="sr-only">(opens in a new tab)</span>
            </span>
            <span class="mt-1 block text-sm text-muted">
              The JSON files this page is built from, in {SITE_NAME} v{SITE_VERSION}, under the MIT license.
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  /* Global on purpose: a scoped block would add a scope attribute to every cell of every row. */

  /* ---- Brand cards ------------------------------------------------------- */

  .oem-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* The heading link covers the whole card; the guide link sits above it. */
  .oem-card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-box);
  }

  .oem-card-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: auto;
    padding-top: 1rem;
  }

  .oem-card:hover .oem-card-foot > span {
    color: var(--color-accent-hover);
  }

  .oem-card-guide {
    position: relative;
    z-index: 1;
  }

  /* ---- Filters ----------------------------------------------------------- */

  .rules-filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    align-items: end;
    gap: var(--spacing-stack-sm) var(--spacing-stack);
  }

  .rules-filter-q {
    grid-column: 1 / -1;
  }

  .rules-filter-reset {
    justify-self: start;
  }

  @media (min-width: 64rem) {
    .rules-filters {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1.2fr) minmax(0, 1.2fr) auto;
    }

    .rules-filter-q {
      grid-column: auto;
    }
  }

  /* Without JavaScript the controls cannot do anything: show the plain table only. */
  @media (scripting: none) {
    .rules-filters,
    .rules-status {
      display: none;
    }
  }

  /* The rule table is the shared .table-stack (src/styles/global.css). */
</style>

<script>
  // Filter the rule table in place. The rows are in the HTML; this only hides the ones that do not
  // match, reports the count in the live region and mirrors the state in the URL.
  const form = document.querySelector<HTMLFormElement>('#rule-filters');
  const table = document.querySelector<HTMLTableElement>('#rules-table');
  const wrap = document.querySelector<HTMLElement>('#rules');
  const status = document.querySelector<HTMLElement>('#rule-status');
  const empty = document.querySelector<HTMLElement>('#rule-empty');
  const explorer = document.querySelector<HTMLElement>('#rules-explorer');

  if (form && table && wrap && status && empty && explorer) {
    const query = form.elements.namedItem('q') as HTMLInputElement;
    const brand = form.elements.namedItem('brand') as HTMLSelectElement;
    const tier = form.elements.namedItem('tier') as HTMLSelectElement;

    // Old /oems#<anchor> links, mapped to a brand id at build time.
    const anchors: Record<string, string> = JSON.parse(form.dataset.anchors ?? '{}');

    const rows = Array.from(table.tBodies[0].rows);
    const haystack = rows.map((row) =>
      Array.from(row.cells, (cell) => cell.textContent ?? '')
        .join(' ')
        .toLowerCase(),
    );
    const total = rows.length;
    let timer = 0;

    const hasOption = (select: HTMLSelectElement, value: string) =>
      Array.from(select.options).some((option) => option.value === value);

    const filter = () => {
      const terms = query.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      let last: HTMLTableRowElement | null = null;

      rows.forEach((row, index) => {
        const match =
          (!brand.value || row.dataset.b === brand.value) &&
          (!tier.value || row.dataset.t === tier.value) &&
          terms.every((term) => haystack[index].includes(term));
        row.hidden = !match;
        row.classList.remove('is-last');
        if (match) {
          shown += 1;
          last = row;
        }
      });

      (last as HTMLTableRowElement | null)?.classList.add('is-last');
      wrap.hidden = shown === 0;
      empty.hidden = shown !== 0;
      return shown === total ? `Showing all ${total} rules.` : `Showing ${shown} of ${total} rules.`;
    };

    const writeUrl = () => {
      const params = new URLSearchParams();
      if (query.value.trim()) params.set('q', query.value.trim());
      if (brand.value) params.set('brand', brand.value);
      if (tier.value) params.set('tier', tier.value);
      const search = params.toString();
      try {
        history.replaceState(history.state, '', `${location.pathname}${search ? `?${search}` : ''}#${explorer.id}`);
      } catch {
        // Some browsers limit how often the URL may change. The filter itself still works.
      }
    };

    // Rows change at once. The announcement and the URL wait until typing pauses, unless `now`.
    const update = (updateUrl: boolean, now = false) => {
      const text = filter();
      const finish = () => {
        if (status.textContent?.trim() !== text) status.textContent = text;
        if (updateUrl) writeUrl();
      };
      window.clearTimeout(timer);
      if (now) finish();
      else timer = window.setTimeout(finish, 250);
    };

    const readQuery = () => {
      const params = new URLSearchParams(location.search);
      const brandParam = params.get('brand') ?? '';
      const tierParam = params.get('tier') ?? '';
      query.value = params.get('q') ?? '';
      brand.value = hasOption(brand, brandParam) ? brandParam : '';
      tier.value = hasOption(tier, tierParam) ? tierParam : '';
    };

    const readAnchor = () => {
      const anchor = location.hash.slice(1);
      if (!anchor || !Object.hasOwn(anchors, anchor) || !hasOption(brand, anchors[anchor])) return false;
      query.value = '';
      tier.value = '';
      brand.value = anchors[anchor];
      return true;
    };

    // The URL is rewritten first, so the browser's own scroll-to-fragment (which can run after
    // this script on a first load) also goes to the rule list, not to the brand card.
    const openAnchor = () => {
      if (!readAnchor()) return false;
      update(true, true);
      explorer.scrollIntoView({ behavior: 'instant' });
      return true;
    };

    const reset = () => {
      query.value = '';
      brand.value = '';
      tier.value = '';
      update(true);
    };

    query.addEventListener('input', () => update(true));
    brand.addEventListener('change', () => update(true));
    tier.addEventListener('change', () => update(true));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      update(true);
    });
    document.querySelector('#rule-reset')?.addEventListener('click', reset);
    document.querySelector('#rule-empty-reset')?.addEventListener('click', () => {
      reset();
      query.focus();
    });
    window.addEventListener('hashchange', openAnchor);

    if (!openAnchor()) {
      readQuery();
      update(false, true);
    }
  }
</script>
