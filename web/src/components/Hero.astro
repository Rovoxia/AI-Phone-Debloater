---
// src/components/Hero.astro
const AI_PROMPT = `Clone https://github.com/Rovoxia/AI-Phone-Debloater.git and guide me through safely debloating my connected Android phone. Execute the workflow strictly in the following order:

1. Clone & Verify Connection:
   - Clone the repository and enter the directory.
   - Verify that my Android device is connected and authorized via ADB.

2. Device Scan & Breakdown:
   - Run python debloat.py scan (or inspect packages).
   - Present a clear summary of my device information and detected bloatware packages.

3. Tier & Dry-Run Prompt (Interactive Check):
   - Clearly ask me which debloat tier I want to use (defaulting to Tier 1 — Safe if I don't specify).
   - Ask if I would like to run a 'dry-run' simulation first before making actual changes:
     * If YES: Run the dry-run for the selected tier, show exact packages, and wait for confirmation.
     * If NO: Proceed directly to step 4.

4. Auto-Snapshot & Safe Execution:
   - Take an automatic snapshot of current package states so changes can be easily rolled back.
   - Execute the debloat while ensuring all personal data, app data, and user files remain 100% intact (-k flag).
   - Show a final summary of completed actions and backup location.`;
---

<section id="prompt" class="pt-10 pb-16 sm:pt-16 sm:pb-24 border-b border-slate-200 dark:border-slate-800/80 bg-gradient-to-b from-slate-50/50 via-white to-white dark:from-[#090d16] dark:via-[#0b0f19] dark:to-[#0b0f19]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-300 mb-5 shadow-xs">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Universal Android ADB Debloater • Zero Root • 100% Safe</span>
      </div>

      <h1 class="text-3xl sm:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
        Clean Your Phone With <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-emerald-500 via-teal-400 to-cyan-500 bg-clip-text text-transparent">AI, CLI or WebApp</span>
      </h1>

      <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        Choose your preferred way to debloat your device. Powered by automated rollback snapshots, zero personal data loss (<code class="font-mono text-emerald-600 dark:text-emerald-400">-k</code>), and 320+ curated OEM safety rules.
      </p>
    </div>

    <!-- Redesigned 3-Way Execution Card -->
    <div class="rounded-2xl border border-slate-200/90 bg-white p-4 sm:p-8 shadow-xl dark:border-slate-800 dark:bg-[#0e1320]">

      <!-- Mode Selector Tabs -->
      <div class="grid grid-cols-3 gap-2 p-1.5 rounded-xl bg-slate-100 dark:bg-slate-900/90 mb-8 border border-slate-200/60 dark:border-slate-800">
        <button
          type="button"
          data-tab="ai"
          class="hero-tab-btn flex items-center justify-center gap-2 rounded-lg py-2.5 px-3 text-xs sm:text-sm font-bold bg-white text-slate-900 shadow-sm dark:bg-slate-800 dark:text-white transition-all cursor-pointer"
        >
          <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>1. AI Prompt</span>
        </button>
        <button
          type="button"
          data-tab="cli"
          class="hero-tab-btn flex items-center justify-center gap-2 rounded-lg py-2.5 px-3 text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
        >
          <svg class="h-4 w-4 text-cyan-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          <span>2. Terminal CLI</span>
        </button>
        <button
          type="button"
          data-tab="webapp"
          class="hero-tab-btn flex items-center justify-center gap-2 rounded-lg py-2.5 px-3 text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
        >
          <svg class="h-4 w-4 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span>3. WebApp</span>
        </button>
      </div>

      <!-- Tab Content 1: AI Prompt -->
      <div id="content-ai" class="hero-content space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">Copy Master AI Prompt</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Feed this to Claude Code, ChatGPT, Cursor, or Gemini for an interactive guided debloat session.</p>
          </div>
          <button
            type="button"
            id="copy-hero-prompt-btn"
            data-prompt={AI_PROMPT}
            class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all active:scale-[0.98] cursor-pointer dark:bg-emerald-500 dark:hover:bg-emerald-600 dark:text-slate-950"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="copy-hero-prompt-label">Copy Master Prompt</span>
          </button>
        </div>

        <div class="relative rounded-xl border border-slate-200 bg-slate-900 p-4 font-mono text-xs text-slate-300 overflow-x-auto max-h-48">
          <pre class="whitespace-pre-wrap">{AI_PROMPT}</pre>
        </div>
      </div>

      <!-- Tab Content 2: Terminal CLI (via website install script endpoint) -->
      <div id="content-cli" class="hero-content hidden space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">Single-Command Terminal Runner</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Run the single command below in your terminal to fetch and run the debloat script directly from the website.</p>
          </div>
        </div>

        <div class="space-y-3">
          <div>
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Windows (PowerShell)</div>
            <div class="flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-900 p-3 font-mono text-xs text-cyan-300">
              <span class="truncate">irm https://debloat.rovoxia.com/install.ps1 | iex</span>
              <button
                type="button"
                class="single-cmd-copy flex-shrink-0 rounded bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs text-white transition-colors cursor-pointer"
                data-cmd="irm https://debloat.rovoxia.com/install.ps1 | iex"
              >
                Copy
              </button>
            </div>
          </div>

          <div>
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">macOS / Linux (Bash / Zsh)</div>
            <div class="flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-900 p-3 font-mono text-xs text-cyan-300">
              <span class="truncate">curl -sSL https://debloat.rovoxia.com/install.sh | bash</span>
              <button
                type="button"
                class="single-cmd-copy flex-shrink-0 rounded bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs text-white transition-colors cursor-pointer"
                data-cmd="curl -sSL https://debloat.rovoxia.com/install.sh | bash"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab Content 3: WebApp (via website install script endpoint) -->
      <div id="content-webapp" class="hero-content hidden space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
          <div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white">Zero-Install Local WebApp Bridge</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Launch the browser-based ADB dashboard with a single website command. Auto-downloads portable ADB and starts local server.</p>
          </div>
          <a
            href="/app"
            class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-4 py-2 text-xs font-bold text-white shadow-sm transition-all cursor-pointer dark:bg-emerald-500 dark:hover:bg-emerald-600 dark:text-slate-950"
          >
            <span>Open WebApp UI</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="space-y-3">
          <div>
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Windows (PowerShell 1-Click Bridge)</div>
            <div class="flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-900 p-3 font-mono text-xs text-emerald-300">
              <span class="truncate">irm https://debloat.rovoxia.com/install.ps1 | iex</span>
              <button
                type="button"
                class="single-cmd-copy flex-shrink-0 rounded bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs text-white transition-colors cursor-pointer"
                data-cmd="irm https://debloat.rovoxia.com/install.ps1 | iex"
              >
                Copy
              </button>
            </div>
          </div>

          <div>
            <div class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">macOS / Linux (Bash 1-Click Bridge)</div>
            <div class="flex items-center justify-between gap-2 rounded-xl border border-slate-200 bg-slate-900 p-3 font-mono text-xs text-emerald-300">
              <span class="truncate">curl -sSL https://debloat.rovoxia.com/install.sh | bash</span>
              <button
                type="button"
                class="single-cmd-copy flex-shrink-0 rounded bg-slate-800 hover:bg-slate-700 px-3 py-1.5 text-xs text-white transition-colors cursor-pointer"
                data-cmd="curl -sSL https://debloat.rovoxia.com/install.sh | bash"
              >
                Copy
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800/80 dark:bg-slate-900/40 shadow-xs">
        <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">320+</div>
        <div class="text-xs text-slate-500 dark:text-slate-400">Curated OEM Rules</div>
      </div>
      <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800/80 dark:bg-slate-900/40 shadow-xs">
        <div class="text-xl sm:text-2xl font-extrabold text-emerald-600 dark:text-emerald-400">61 Pkgs</div>
        <div class="text-xs text-slate-500 dark:text-slate-400">Protected Core Sentinel</div>
      </div>
      <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800/80 dark:bg-slate-900/40 shadow-xs">
        <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">0% Loss</div>
        <div class="text-xs text-slate-500 dark:text-slate-400">User Data Intact (<code class="font-mono text-[10px]">-k</code>)</div>
      </div>
      <div class="rounded-xl border border-slate-200/80 bg-white p-3.5 dark:border-slate-800/80 dark:bg-slate-900/40 shadow-xs">
        <div class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white">0 Root</div>
        <div class="text-xs text-slate-500 dark:text-slate-400">Safe User 0 Execution</div>
      </div>
    </div>

  </div>
</section>

<script>
  // Tabs switching logic
  const tabs = document.querySelectorAll('.hero-tab-btn');
  const contents = document.querySelectorAll('.hero-content');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      tabs.forEach(t => {
        t.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white', 'font-bold');
        t.classList.add('text-slate-600', 'dark:text-slate-400', 'font-semibold');
      });
      tab.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'dark:bg-slate-800', 'dark:text-white', 'font-bold');
      tab.classList.remove('text-slate-600', 'dark:text-slate-400', 'font-semibold');

      contents.forEach(c => c.classList.add('hidden'));
      document.getElementById(`content-${target}`)?.classList.remove('hidden');
    });
  });

  // Copy buttons
  const copyPromptBtn = document.getElementById('copy-hero-prompt-btn');
  const promptLabel = document.getElementById('copy-hero-prompt-label');
  copyPromptBtn?.addEventListener('click', async () => {
    const text = copyPromptBtn.getAttribute('data-prompt') || '';
    try {
      await navigator.clipboard.writeText(text);
      if (promptLabel) {
        promptLabel.textContent = '✔ Copied to Clipboard!';
        setTimeout(() => { promptLabel.textContent = 'Copy Master Prompt'; }, 2500);
      }
    } catch {
      prompt('Copy prompt:', text);
    }
  });

  document.querySelectorAll('.single-cmd-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-cmd') || '';
      try {
        await navigator.clipboard.writeText(cmd);
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = originalText; }, 2000);
      } catch {
        prompt('Copy command:', cmd);
      }
    });
  });
</script>
