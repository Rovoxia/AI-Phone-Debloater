---
// src/components/SafetyArchitecture.astro
---

<section id="safety" class="py-12 sm:py-16 border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        4-Tier Safety Framework
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
        Every package is classified before execution. Operations run strictly within Android's unprivileged user profile layer.
      </p>
    </div>

    <!-- 4-Column Tier Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">

      <!-- Tier 1 -->
      <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4 flex flex-col justify-between dark:border-emerald-500/30 dark:bg-emerald-500/5">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold text-emerald-700 dark:text-emerald-400">TIER 1</span>
            <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px] font-bold text-emerald-800 dark:text-emerald-300">0% Risk</span>
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Safe Bloatware</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            Carrier diagnostics, ad daemons, Facebook/Meta background services, and telemetry stubs.
          </p>
          <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 space-y-1 border-t border-slate-200 dark:border-slate-800 pt-2.5">
            <div>• Xiaomi MSA &amp; Analytics</div>
            <div>• Meta App Installer</div>
            <div>• OneDrive preloads</div>
          </div>
        </div>
        <div class="mt-4 pt-2.5 border-t border-slate-200 dark:border-slate-800 text-[10px] text-slate-500 font-mono">
          Action: <code class="text-emerald-700 dark:text-emerald-400">pm disable-user</code>
        </div>
      </div>

      <!-- Tier 2 -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col justify-between dark:border-slate-800 dark:bg-[#0c101a]">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold text-cyan-600 dark:text-cyan-400">TIER 2</span>
            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Advanced</span>
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Assistants &amp; Sync</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            OEM proprietary digital assistants, background cloud sync services, and AR avatar stickers.
          </p>
          <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 space-y-1 border-t border-slate-200 dark:border-slate-800 pt-2.5">
            <div>• Samsung Bixby voice agent</div>
            <div>• OEM Cloud synchronizers</div>
            <div>• AR Zone / 3D Stickers</div>
          </div>
        </div>
        <div class="mt-4 pt-2.5 border-t border-slate-200 dark:border-slate-800 text-[10px] text-slate-500 font-mono">
          Action: <code class="text-cyan-600 dark:text-cyan-400">pm disable-user</code>
        </div>
      </div>

      <!-- Tier 3 -->
      <div class="rounded-xl border border-slate-200 bg-white p-4 flex flex-col justify-between dark:border-slate-800 dark:bg-[#0c101a]">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold text-purple-600 dark:text-purple-400">TIER 3</span>
            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Expert</span>
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Stock Apps</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            OEM bundled default apps when alternative apps (Gboard, Chrome, F-Droid) are already active.
          </p>
          <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 space-y-1 border-t border-slate-200 dark:border-slate-800 pt-2.5">
            <div>• Samsung / Mi Internet Browser</div>
            <div>• OEM Stock Keyboard</div>
            <div>• Bundled Calculators &amp; Notes</div>
          </div>
        </div>
        <div class="mt-4 pt-2.5 border-t border-slate-200 dark:border-slate-800 text-[10px] text-slate-500 font-mono">
          Action: <code class="text-purple-600 dark:text-purple-400">pm uninstall -k</code>
        </div>
      </div>

      <!-- Tier 4 -->
      <div class="rounded-xl border border-rose-500/30 bg-rose-500/5 p-4 flex flex-col justify-between dark:border-rose-500/30 dark:bg-rose-500/5">
        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-mono text-xs font-bold text-rose-600 dark:text-rose-400">TIER 4</span>
            <span class="rounded bg-rose-500/20 px-1.5 py-0.5 text-[10px] font-bold text-rose-800 dark:text-rose-300">HARD BLOCKED</span>
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1.5">Critical Sentinel</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-3">
            Hardcoded blacklist enforced at engine level. Any attempt to modify will immediately abort.
          </p>
          <div class="text-[11px] font-mono text-slate-500 dark:text-slate-400 space-y-1 border-t border-slate-200 dark:border-slate-800 pt-2.5">
            <div>• <code class="text-rose-700 dark:text-rose-300">com.android.systemui</code></div>
            <div>• <code class="text-rose-700 dark:text-rose-300">com.android.phone</code></div>
            <div>• <code class="text-rose-700 dark:text-rose-300">com.google.android.gms</code></div>
          </div>
        </div>
        <div class="mt-4 pt-2.5 border-t border-slate-200 dark:border-slate-800 text-[10px] text-rose-600 dark:text-rose-400 font-mono font-bold">
          Protected: 61 packages
        </div>
      </div>

    </div>

    <!-- 4 Architecture Safeguards Bar -->
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/40">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div>
          <div class="font-bold text-slate-900 dark:text-white mb-1">Rootless dm-verity</div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]">System partitions remain read-only. Zero firmware modification.</p>
        </div>
        <div>
          <div class="font-bold text-slate-900 dark:text-white mb-1">User 0 &amp; -k Flag</div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]">Personal databases in <code class="font-mono text-[10px]">/data/user/0/</code> remain intact.</p>
        </div>
        <div>
          <div class="font-bold text-slate-900 dark:text-white mb-1">Auto JSON Snapshots</div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]">Pre-debloat snapshots saved for instant 1-click restore.</p>
        </div>
        <div>
          <div class="font-bold text-slate-900 dark:text-white mb-1">Knox 0x0 &amp; SafetyNet</div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]">Warranty intact. Google Play Integrity and banking apps pass.</p>
        </div>
      </div>
    </div>

  </div>
</section>
