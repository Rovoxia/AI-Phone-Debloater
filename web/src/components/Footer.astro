---
// Site footer. No JSON-LD here: structured data is emitted once per page by SeoHead.astro.
// Column titles are <p> elements that label their lists, not headings, so the footer never adds
// to a page's heading outline.
import Icon from './Icon.astro';
import { GITHUB_REPO, ORG_NAME, ORG_URL, SITE_NAME } from '../lib/seo';
import { SITE_VERSION } from '../lib/version';

const year = new Date().getFullYear();

interface FooterLink {
  name: string;
  href: string;
  external?: boolean;
}

// The home page keeps id="cli" and id="faq" for the two anchor links below.
const columns: { id: string; title: string; links: FooterLink[] }[] = [
  {
    id: 'footer-product',
    title: 'Product',
    links: [
      { name: 'Web app', href: '/app' },
      { name: 'Package list by OEM', href: '/oems' },
      { name: 'Install the CLI', href: '/#cli' },
      { name: 'FAQ', href: '/#faq' },
      { name: 'Releases', href: `${GITHUB_REPO}/releases`, external: true },
    ],
  },
  {
    id: 'footer-guides',
    title: 'Guides',
    links: [
      { name: 'All guides', href: '/blog' },
      { name: 'Samsung One UI', href: '/blog/samsung-galaxy-debloat-guide-one-ui-6' },
      { name: 'Xiaomi HyperOS', href: '/blog/xiaomi-hyperos-debloat-guide' },
      { name: 'Google Pixel', href: '/blog/pixel-debloat-guide-stock-android' },
      { name: 'Safety tiers explained', href: '/blog/adb-debloat-safety-tiers-explained' },
      { name: 'Wireless ADB setup', href: '/blog/wireless-adb-debloat-setup-android-11' },
    ],
  },
  {
    id: 'footer-project',
    title: 'Project',
    links: [
      { name: 'GitHub repository', href: GITHUB_REPO, external: true },
      { name: 'Report an issue', href: `${GITHUB_REPO}/issues`, external: true },
      {
        name: 'Request a rule',
        href: `${GITHUB_REPO}/issues/new?template=package_rule_request.md`,
        external: true,
      },
      { name: 'Changelog', href: `${GITHUB_REPO}/blob/main/CHANGELOG.md`, external: true },
      { name: 'MIT License', href: `${GITHUB_REPO}/blob/main/LICENSE`, external: true },
    ],
  },
  {
    id: 'footer-agents',
    title: 'For AI agents',
    links: [
      { name: 'llms.txt', href: '/llms.txt' },
      { name: 'llms-full.txt', href: '/llms-full.txt' },
      { name: 'Master prompt', href: '/prompt.md' },
      { name: 'pricing.md', href: '/pricing.md' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container-page">
    <div class="top">
      <div class="about">
        <p class="name">{SITE_NAME}</p>
        <p class="blurb">
          Free, open-source Android debloater. It removes preinstalled apps over ADB without root and saves a
          restore snapshot before every change.
        </p>
        <p class="tags">
          <span class="badge badge-mono">v{SITE_VERSION}</span>
          <span class="badge">MIT License</span>
        </p>
      </div>

      <nav aria-label="Footer" class="columns">
        {
          columns.map((column) => (
            <div>
              <p id={column.id} class="title">
                {column.title}
              </p>
              <ul aria-labelledby={column.id}>
                {column.links.map((link) => (
                  <li>
                    {link.external ? (
                      <a href={link.href} class="footer-link" target="_blank" rel="noopener noreferrer">
                        {link.name}
                        <Icon name="arrow-up-right" class="size-3.5" />
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    ) : (
                      <a href={link.href} class="footer-link">
                        {link.name}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="bottom">
      <p>
        &copy; {year}
        <a href={ORG_URL} class="footer-link inline" target="_blank" rel="noopener noreferrer">{ORG_NAME}<span class="sr-only"> (opens in a new tab)</span></a>. Released under the MIT License.
      </p>
      <p class="legal">
        Android is a trademark of Google LLC. Brand names are used only to identify compatible devices.
      </p>
      <a href="#top" class="footer-link to-top">
        <Icon name="arrow-up" class="size-4" />
        Back to top
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background-color: var(--color-band);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  .top {
    display: grid;
    gap: var(--spacing-stack-lg);
    padding-block: var(--spacing-section-sm);
  }

  .about {
    max-width: 24rem;
  }

  .name {
    color: var(--color-ink);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .blurb {
    margin-top: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  /* As many link columns as fit: 2 on a phone, 4 on a desktop, no breakpoints. */
  .columns {
    display: grid;
    gap: var(--spacing-stack-lg) var(--spacing-stack);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }

  .title {
    margin-bottom: 0.5rem;
    color: var(--color-faint);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2rem;
    color: var(--color-muted);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .footer-link:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }

  .footer-link.inline {
    min-height: 0;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration-color: var(--color-line-control);
  }

  .bottom {
    display: grid;
    gap: 0.75rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-faint);
    font-size: var(--text-xs);
    line-height: var(--text-xs--line-height);
  }

  .to-top {
    justify-self: start;
    color: var(--color-faint);
  }

  @media (pointer: coarse) {
    .footer-link:not(.inline) {
      min-height: 2.75rem;
    }
  }

  @media (min-width: 64rem) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.25fr);
    }

    .bottom {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2rem;
    }

    .legal {
      text-align: right;
    }
  }
</style>
