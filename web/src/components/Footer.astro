---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white py-12 text-slate-500 text-sm dark:border-slate-800 dark:bg-[#07090e] dark:text-slate-400">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Brand + tagline column -->
    <div class="flex items-start justify-between gap-8 lg:grid lg:grid-cols-3 lg:gap-12 lg:items-start mb-10">

      <div class="lg:col-span-1 space-y-4">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 text-white shadow-sm">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5.5" y="2" width="13" height="20" rx="3" />
              <line x1="10" y1="5" x2="14" y2="5" />
              <path d="M12 9c0 1.8-1.3 3-3 3 1.7 0 3 1.2 3 3 0-1.8 1.3-3 3-3-1.7 0-3-1.2-3-3z" fill="currentColor" stroke="none" />
              <line x1="10.5" y1="18.5" x2="13.5" y2="18.5" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-slate-900 dark:text-white">AI Phone Debloater</span>
        </div>
        <p class="text-sm leading-relaxed max-w-[260px]">
          Safe, rootless Android debloating with ADB — no root, 100% reversible, and 320+ curated OEM safety rules.
        </p>
        <div class="flex items-center gap-2">
          <span class="rounded bg-emerald-500/10 px-2.5 py-1 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400">MIT Open Source</span>
          <span class="rounded bg-slate-200/70 px-2.5 py-1 text-[10px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">Rootless ADB</span>
        </div>
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-1 space-y-3">
        <div class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider mb-2">Product</div>
        <ul class="space-y-2">
          <li><a href="/#features" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Features</a></li>
          <li><a href="/#cli" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">CLI Run</a></li>
          <li><a href="/#safety" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Safety Tiers</a></li>
          <li><a href="/#rules" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Rules Database</a></li>
          <li><a href="/#faq" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">FAQ</a></li>
          <li><a href="/app" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">WebApp Workspace</a></li>
        </ul>
      </div>

      <!-- External -->
      <div class="lg:col-span-1 space-y-3">
        <div class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider mb-2">Community</div>
        <ul class="space-y-2">
          <li><a href="https://github.com/Rovoxia/AI-Phone-Debloater" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">GitHub →</a></li>
          <li><a href="https://rovoxia.com" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Rovoxia →</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom line -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>
        © {currentYear} <a href="https://rovoxia.com" class="text-slate-900 dark:text-white hover:underline">Rovoxia</a>. MIT License.
      </div>
      <div class="max-w-[280px] text-center sm:text-right">
        Android is a trademark of Google LLC. Brand names are for compatibility reference only.
      </div>
    </div>

  </div>
</footer>
