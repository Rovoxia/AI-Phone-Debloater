---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 py-10 text-slate-600 text-xs dark:border-slate-800 dark:bg-[#07090e] dark:text-slate-400">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">

      <!-- Brand column -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/15 dark:text-emerald-400 ring-1 ring-emerald-500/20">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path d="m13 10-3 5h4l-2 5" stroke="#10b981" stroke-width="2.5" fill="none" />
            </svg>
          </div>
          <span class="text-sm font-bold text-slate-900 dark:text-white">AI-Phone-Debloater</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed max-w-sm">
          Universal rootless Android ADB debloater with automated rollback snapshots, zero personal data loss, and 320+ curated OEM rules.
        </p>
        <div class="flex items-center gap-2 pt-1">
          <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400">
            MIT Open Source
          </span>
          <span class="rounded bg-slate-200/70 px-2 py-0.5 text-[10px] font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
            Rootless ADB
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-2">
        <div class="font-bold text-slate-900 dark:text-white text-xs uppercase tracking-wider">Navigation</div>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/" class="hover:text-slate-950 dark:hover:text-white transition-colors">Home</a></li>
          <li><a href="/app" class="hover:text-slate-950 dark:hover:text-white transition-colors">WebApp Workspace</a></li>
          <li><a href="https://github.com/Rovoxia/AI-Phone-Debloater" target="_blank" rel="noopener noreferrer" class="hover:text-slate-950 dark:hover:text-white transition-colors">GitHub Repository →</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom line -->
    <div class="border-t border-slate-200 dark:border-slate-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500">
      <div>
        © {currentYear} <a href="https://rovoxia.com" class="hover:underline">Rovoxia</a>. MIT License.
      </div>
      <div>
        Android is a trademark of Google LLC. OEM brand names are for compatibility reference only.
      </div>
    </div>

  </div>
</footer>
