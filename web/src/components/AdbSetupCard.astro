---
// Reusable ADB setup card used by both the homepage and the WebApp.
export interface Props {
  variant?: 'landing' | 'workspace'
}

const { variant = 'landing' } = Astro.props;

const WIN_CMD = 'irm https://debloater.rovoxia.com/run.ps1 | iex';
const UNIX_CMD = 'curl -sSL https://debloater.rovoxia.com/run.sh | bash';
---

<section class="rounded-2xl border border-slate-200 bg-white shadow-xs p-6 sm:p-8 dark:border-slate-800 dark:bg-[#181c24]" id="adb-setup-card">
  <div class="grid gap-6">
    <!-- Header -->
    <div class="flex items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-5">
      <div class="flex items-center gap-3.5">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-500/15 dark:text-blue-400">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m13 10-3 5h4l-2 5" stroke="currentColor" stroke-width="2.5" fill="none" />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-semibold text-slate-900 dark:text-white tracking-tight">
            {variant === 'landing' ? 'Quick Setup & Installation' : 'ADB Connection'}
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            {variant === 'landing'
              ? 'Run one command in your terminal to set up ADB and launch the debloater.'
              : 'USB or Wireless Debugging must be enabled on your phone.'}
          </p>
        </div>
      </div>

      {variant === 'workspace' && (
        <div class="flex items-center gap-2 text-xs">
          <span id="adb-status-dot" class="h-2.5 w-2.5 rounded-full bg-amber-500 animate-pulse"></span>
          <span id="adb-status-text" class="font-medium text-slate-600 dark:text-slate-300">Checking ADB…</span>
        </div>
      )}
    </div>

    <!-- Steps Container -->
    <div class="grid gap-5">
      <!-- Step 1 -->
      <div class="flex gap-4 items-start">
        <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300">1</div>
        <div>
          <h3 class="text-xs font-semibold text-slate-900 dark:text-white uppercase tracking-wider">Enable USB Debugging</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">
            Go to Settings &rarr; About Phone &rarr; tap Build Number 7 times. Then enable <span class="font-medium text-slate-800 dark:text-slate-200">USB Debugging</span> (or Wireless Debugging) and allow the prompt.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex gap-4 items-start">
        <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300">2</div>
        <div class="flex-1 space-y-3">
          <h3 class="text-xs font-semibold text-slate-900 dark:text-white uppercase tracking-wider">
            {variant === 'landing' ? 'Run One-Command Setup' : 'Connect Device'}
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Windows PowerShell -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-3.5 dark:border-slate-800 dark:bg-[#121212]">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400">Windows (PowerShell)</span>
                <button
                  type="button"
                  class="copy-btn h-6 w-6 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                  data-cmd={WIN_CMD}
                  title="Copy command"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                </button>
              </div>
              <code class="block font-mono text-[11px] text-slate-800 dark:text-slate-200 leading-relaxed select-all overflow-x-auto py-1">{WIN_CMD}</code>
            </div>

            <!-- macOS / Linux Bash -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/50 p-3.5 dark:border-slate-800 dark:bg-[#121212]">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">macOS / Linux (Bash)</span>
                <button
                  type="button"
                  class="copy-btn h-6 w-6 rounded border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700 transition-colors inline-flex items-center justify-center cursor-pointer shadow-2xs"
                  data-cmd={UNIX_CMD}
                  title="Copy command"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                  </svg>
                </button>
              </div>
              <code class="block font-mono text-[11px] text-slate-800 dark:text-slate-200 leading-relaxed select-all overflow-x-auto py-1">{UNIX_CMD}</code>
            </div>
          </div>

          {variant === 'workspace' && (
            <div class="pt-2 flex items-center gap-2 w-full">
              <button
                type="button"
                id="adb-refresh-btn"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white hover:bg-blue-700 transition-colors cursor-pointer flex-1 shadow-sm"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 4v6h6" /><path d="M23 4v-6h-6" /><path d="M20 4.93A9 9 0 0 1 5.64 12.12c-2.09-.79-3.38-2.89-3.38-5.12" /><path d="M4 19.07A9 9 0 0 1 18.36 11.88c2.09.79 3.38 2.89 3.38 5.12" />
                </svg>
                <span>Refresh &amp; Detect Device</span>
              </button>
            </div>
          )}
        </div>
      </div>

      <!-- Step 3 (Connected) -->
      <div id="adb-connected-box" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/5 p-4 mt-2">
        <div class="flex gap-4 items-start">
          <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold text-white">3</div>
          <div class="flex-1">
            <h3 class="text-xs font-semibold text-slate-900 dark:text-white uppercase tracking-wider">Device Connected Successfully</h3>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">
              Serial: <span id="adb-serial" class="font-mono text-emerald-600 dark:text-emerald-400 font-semibold">—</span> &middot;
              Status: <span id="adb-device-status" class="font-medium text-emerald-600 dark:text-emerald-400">authorized</span>
            </p>

            {variant === 'workspace' && (
              <div class="mt-3 flex items-center gap-2 w-full">
                <button
                  type="button"
                  id="adb-scan-btn"
                  class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-500 transition-colors cursor-pointer flex-1 shadow-sm"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" />
                  </svg>
                  <span>Scan Live Packages</span>
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const copyBtns = document.querySelectorAll('.copy-btn');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cmd = btn.getAttribute('data-cmd') || '';
        try {
          await navigator.clipboard.writeText(cmd);
          const original = btn.innerHTML;
          btn.innerHTML = '<svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(() => {
            btn.innerHTML = original;
          }, 1600);
        } catch {
          prompt('Copy this command:', cmd);
        }
      });
    });
  })();
</script>
