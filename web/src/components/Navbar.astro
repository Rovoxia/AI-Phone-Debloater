---
// src/components/Navbar.astro
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md transition-colors dark:border-slate-800/80 dark:bg-[#0b0f17]/90">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

    <!-- Brand / App Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-600 text-white shadow-sm transition-transform group-hover:scale-105">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5.5" y="2" width="13" height="20" rx="3" />
          <line x1="10" y1="5" x2="14" y2="5" />
          <path d="M12 9c0 1.8-1.3 3-3 3 1.7 0 3 1.2 3 3 0-1.8 1.3-3 3-3-1.7 0-3-1.2-3-3z" fill="currentColor" stroke="none" />
          <line x1="10.5" y1="18.5" x2="13.5" y2="18.5" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-sm sm:text-base font-bold tracking-tight text-slate-900 dark:text-white">AI Phone Debloater</span>
        <span class="hidden sm:inline-block text-[10px] font-mono font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border border-slate-200 dark:border-slate-700">v1.0</span>
      </div>
    </a>

    <!-- Main Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="/#features" class="rounded-lg px-3 py-1.5 hover:text-slate-950 hover:bg-slate-100 dark:hover:text-white dark:hover:bg-slate-800/60 transition-colors">Features</a>
      <a href="/#cli" class="rounded-lg px-3 py-1.5 hover:text-slate-950 hover:bg-slate-100 dark:hover:text-white dark:hover:bg-slate-800/60 transition-colors">CLI Run</a>
      <a href="/#safety" class="rounded-lg px-3 py-1.5 hover:text-slate-950 hover:bg-slate-100 dark:hover:text-white dark:hover:bg-slate-800/60 transition-colors">Safety Tiers</a>
      <a href="/#rules" class="rounded-lg px-3 py-1.5 hover:text-slate-950 hover:bg-slate-100 dark:hover:text-white dark:hover:bg-slate-800/60 transition-colors">Rules</a>
      <a href="/#faq" class="rounded-lg px-3 py-1.5 hover:text-slate-950 hover:bg-slate-100 dark:hover:text-white dark:hover:bg-slate-800/60 transition-colors">FAQ</a>
    </nav>

    <!-- Right Controls: GitHub Repo + GitHub Star + Theme Only -->
    <div class="flex items-center gap-2 sm:gap-2.5">

      <!-- GitHub Repo Link (Icon) -->
      <a
        href="https://github.com/Rovoxia/AI-Phone-Debloater"
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 dark:border-slate-800 dark:bg-[#151922] dark:text-slate-300 dark:hover:bg-slate-800 transition-colors cursor-pointer shadow-2xs"
        aria-label="GitHub Repository"
        title="View repository on GitHub"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- GitHub Star Button (Separate) -->
      <a
        href="https://github.com/Rovoxia/AI-Phone-Debloater"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 h-9 rounded-lg border border-slate-200 bg-white px-2.5 sm:px-3 text-xs font-semibold text-slate-700 shadow-2xs hover:bg-slate-50 dark:border-slate-800 dark:bg-[#151922] dark:text-slate-200 dark:hover:bg-slate-800 transition-colors group cursor-pointer"
        title="Star AI-Phone-Debloater on GitHub"
      >
        <svg class="h-3.5 w-3.5 text-amber-500 fill-amber-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
        </svg>
        <span>Star</span>
        <span id="gh-stars-count" class="hidden text-[11px] font-mono font-medium text-slate-500 dark:text-slate-400 pl-1 border-l border-slate-200 dark:border-slate-700"></span>
      </a>

      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-800 dark:bg-[#151922] dark:text-slate-300 dark:hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Toggle theme"
        title="Toggle dark / light theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 dark:border-slate-800 dark:bg-[#151922] dark:text-slate-300 shadow-xs cursor-pointer"
        aria-label="Toggle mobile menu"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 py-3 space-y-1 text-sm font-medium text-slate-700 dark:border-slate-800 dark:bg-[#0b0f17]/95 dark:text-slate-200">
    <a href="/#features" class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">Features</a>
    <a href="/#cli" class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">CLI Run</a>
    <a href="/#safety" class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">Safety Tiers</a>
    <a href="/#rules" class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">Rules Database</a>
    <a href="/#faq" class="block rounded-lg px-3 py-2 hover:bg-slate-100 dark:hover:bg-slate-800">FAQ</a>
    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex gap-2">
      <a
        href="https://github.com/Rovoxia/AI-Phone-Debloater"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 flex-1 rounded-lg bg-slate-100 dark:bg-slate-800 px-3 py-2 text-center text-xs font-semibold text-slate-800 dark:text-slate-200"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>
      <a
        href="https://github.com/Rovoxia/AI-Phone-Debloater"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-1.5 flex-1 rounded-lg bg-amber-500/10 border border-amber-500/20 px-3 py-2 text-center text-xs font-semibold text-amber-700 dark:text-amber-400"
      >
        <svg class="h-3.5 w-3.5 text-amber-500 fill-amber-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
        </svg>
        <span>Star</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => menu.classList.toggle('hidden'));
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }

  // Theme switcher toggle
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const nextTheme = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
      if (nextTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      try {
        localStorage.setItem('theme', nextTheme);
      } catch (e) {}
    });
  }

  // Fetch live GitHub Stars
  const starCountEl = document.getElementById('gh-stars-count');
  if (starCountEl) {
    fetch('https://api.github.com/repos/Rovoxia/AI-Phone-Debloater')
      .then((res) => res.ok ? res.json() : null)
      .then((data) => {
        if (data && typeof data.stargazers_count === 'number') {
          starCountEl.textContent = data.stargazers_count.toLocaleString();
          starCountEl.classList.remove('hidden');
        }
      })
      .catch(() => {});
  }
</script>
