---
// Site header: brand, primary navigation, theme toggle and the mobile menu.
// The script at the bottom is bundled and hashed by Astro, so it is CSP-safe.
import Icon from './Icon.astro';
import { GITHUB_REPO, SITE_NAME, currentPath } from '../lib/seo';

const path = currentPath(Astro.url);

const links = [
  { name: 'Home', href: '/' },
  { name: 'Web app', href: '/app' },
  { name: 'OEM list', href: '/oems' },
  { name: 'Guides', href: '/blog' },
];

// "/" matches only the home page; the others also match their sub-pages (/blog/<slug>).
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header" data-site-header>
  <div class="container-page bar">
    <a href="/" class="brand">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#059669"></rect>
        <rect x="8" y="5" width="16" height="22" rx="3.5" stroke="#ffffff" stroke-width="1.75" fill="none"></rect>
        <line x1="13.5" y1="8" x2="18.5" y2="8" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></line>
        <path d="M16 11.5c0 2.2-1.6 3.8-3.8 3.8 2.2 0 3.8 1.6 3.8 3.8 0-2.2 1.6-3.8 3.8-3.8-2.2 0-3.8-1.6-3.8-3.8z" fill="#ffffff"></path>
        <line x1="13" y1="23.5" x2="19" y2="23.5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></line>
      </svg>
      <span>{SITE_NAME}</span>
    </a>

    <nav aria-label="Primary" class="desktop-nav">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={GITHUB_REPO} class="nav-link" target="_blank" rel="noopener noreferrer">
            <Icon name="github" class="size-4" />
            GitHub
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <button type="button" class="icon-btn" data-theme-toggle aria-pressed="false" aria-label="Dark theme">
        <Icon name="moon" class="when-light" />
        <Icon name="sun" class="when-dark" />
      </button>
      <button
        type="button"
        class="icon-btn menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
      >
        <Icon name="menu" class="when-closed" />
        <Icon name="x" class="when-open" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile" class="container-page">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="mobile-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
        <li>
          <a href={GITHUB_REPO} class="mobile-link" target="_blank" rel="noopener noreferrer">
            <span class="mobile-link-label">
              <Icon name="github" class="size-4" />
              GitHub
              <span class="sr-only">(opens in a new tab)</span>
            </span>
            <Icon name="arrow-up-right" class="size-4" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* The header is a query container: the switch from the menu button to the full navigation
     (below) is a container query in rem. Unlike a media query in rem, it follows the root font
     size, so the navigation still fits when the text is enlarged without the layout viewport
     changing (text-only zoom, a larger root font size). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    container: site-header / inline-size;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-surface);
  }

  /* Frosted glass where the browser can blur what is behind the header; solid otherwise. */
  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .site-header {
      background-color: var(--color-header);
      -webkit-backdrop-filter: blur(20px) saturate(1.4);
      backdrop-filter: blur(20px) saturate(1.4);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--spacing-header);
  }

  /* The name stays on one line while there is room. On a narrow screen with enlarged text it
     wraps, at any character if it must, so the buttons beside it stay on screen. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    min-height: 2.75rem;
    color: var(--color-ink);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .brand-mark {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    box-shadow: var(--shadow-control);
  }

  .desktop-nav {
    display: none;
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: var(--spacing-header);
    padding-inline: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  /* Hover: a soft rounded fill behind the label, drawn on a pseudo-element because the link
     itself is as tall as the header. */
  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0.875rem 0.125rem;
    z-index: -1;
    border-radius: 0.5rem;
    background-color: var(--color-inset);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link:hover::before {
    opacity: 1;
  }

  .nav-link[aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Active page: a 2px bar on the header's bottom edge, so the cue is not colour alone. */
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    bottom: -1px;
    left: 0.75rem;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background-image: linear-gradient(to right, var(--color-gradient-from), var(--color-gradient-to));
    background-color: var(--color-accent);
  }

  .nav-link:focus-visible {
    outline-offset: -4px;
  }

  .actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    margin-right: -0.5rem;
  }

  .when-dark,
  :global(.dark) .when-light {
    display: none;
  }

  :global(.dark) .when-dark {
    display: block;
  }

  .when-open,
  .menu-toggle[aria-expanded="true"] .when-closed {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .when-open {
    display: block;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    max-height: calc(100dvh - var(--spacing-header));
    overflow-y: auto;
    border-bottom: 1px solid var(--color-line);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-raised);
  }

  .mobile-menu ul {
    padding-block: 0.5rem 1rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 1rem;
    font-weight: 500;
  }

  .mobile-menu li:last-child .mobile-link {
    border-bottom: 0;
  }

  .mobile-link:hover {
    color: var(--color-ink);
  }

  .mobile-link-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Active page: an accent bar before the label, so the cue is not colour alone. */
  .mobile-link[aria-current="page"] {
    justify-content: flex-start;
    color: var(--color-ink);
    font-weight: 600;
  }

  .mobile-link[aria-current="page"]::before {
    content: "";
    width: 2px;
    height: 1.25rem;
    background-color: var(--color-accent);
  }

  @container site-header (min-width: 48rem) {
    .desktop-nav {
      display: block;
    }

    .actions {
      margin-left: 0.25rem;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  // Theme toggle. The bootstrap script in SeoHead.astro reads localStorage "theme" ("light" or
  // "dark") before first paint; this writes the same key.
  const root = document.documentElement;
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

  const storedTheme = (): string | null => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  function applyTheme(dark: boolean): void {
    root.classList.toggle('dark', dark);
    root.setAttribute('data-theme', dark ? 'dark' : 'light');
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(dark));
    });
    // Keep the browser chrome in step with the theme the page shows, not only with the OS.
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
      meta.setAttribute('content', dark ? '#0b1120' : '#ffffff');
    });
  }

  applyTheme(root.classList.contains('dark'));

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const dark = !root.classList.contains('dark');
      applyTheme(dark);
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        // Storage can be blocked; the choice then lasts for this page view only.
      }
    });
  });

  // No stored choice: follow the OS when it changes.
  prefersDark.addEventListener('change', (event) => {
    if (!storedTheme()) applyTheme(event.matches);
  });

  // A choice made in another tab.
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') applyTheme(event.newValue ? event.newValue === 'dark' : prefersDark.matches);
  });

  // Mobile menu.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header && menuToggle && menu) {
    const setMenu = (open: boolean, returnFocus = false): void => {
      menu.hidden = !open;
      menuToggle.setAttribute('aria-expanded', String(open));
      if (returnFocus) menuToggle.focus();
    };

    menuToggle.addEventListener('click', () => setMenu(menu.hidden));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setMenu(false, true);
    });

    // A click or tap anywhere outside the header closes the menu.
    document.addEventListener('click', (event) => {
      if (!menu.hidden && event.target instanceof Node && !header.contains(event.target)) setMenu(false);
    });

    // Following a link closes it too (matters for same-page anchors).
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
    });

    // The menu does not exist in the wide layout (a container query in the styles above); do not
    // leave it open across a resize. The button is hidden exactly when that layout is on.
    window.addEventListener('resize', () => {
      if (!menu.hidden && menuToggle.offsetParent === null) setMenu(false);
    });
  }
</script>
